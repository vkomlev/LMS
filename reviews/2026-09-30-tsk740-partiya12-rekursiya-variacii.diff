+GLAVA_ID = 1490
+KURS_UID = "lms:tsk740:ege2027:23:var"
+KURS_TITLE = "Вариации вопроса: через вершину, в обход, с ограничениями"
+KURS_DESCR = ("Как меняется программа, когда в задании 23 добавляют условие: путь через "
