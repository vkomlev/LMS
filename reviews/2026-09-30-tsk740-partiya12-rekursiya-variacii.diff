+VYVOD = project_root / "reviews" / "tsk740-var23"
+DEMO = project_root / "reviews" / "2026-09-01-tsk740-fipi-demo23.txt"
+UROK_HTML = Path(__file__).resolve().parent / "tsk740_block23_lessons" / "m_var.html"
