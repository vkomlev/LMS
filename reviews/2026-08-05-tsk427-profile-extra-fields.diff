+    result = await db.execute(
+        select(
+            Users.full_name,
+            Users.category,
+            Users.school_grade,
+            Users.city,
+            Users.timezone,
+        ).where(Users.id == user_id)
+    )
+    row = result.one_or_none()
+    if row is None:
+        return None
