+async def _with_plan(db: Any, plan: str, call: Callable[[], Awaitable[Any]]) -> Any:
+    """Выполнить `call` при плане `plan` (настройки — до конца вызова)."""
+    for stmt in _PLANS[plan]:
+        await db.execute(text(stmt))
+    try:
+        _reset_caches(db)
+        return await call()
+    finally:
+        for stmt in _PLAN_RESET:
+            await db.execute(text(stmt))
