+const starsFor = (m) => (m === 0 ? 3 : m <= 2 ? 2 : 1);
+
+/* ---------- маскот (SVG) ---------- */
+function mascotSVG(mood) {
+  const mouth = mood === "sad" ? "M22 44 Q32 36 42 44" : mood === "think" ? "M23 42 L41 42" : "M22 40 Q32 50 42 40";
+  return `<svg class="mascot ${mood}" viewBox="0 0 64 64" aria-hidden="true">
+    <ellipse cx="32" cy="36" rx="26" ry="22" fill="var(--mascot)"/>
+    <ellipse cx="32" cy="42" rx="17" ry="11" fill="#bfe8cd" opacity=".55"/>
+    <circle cx="22" cy="28" r="7" fill="#fff"/><circle cx="42" cy="28" r="7" fill="#fff"/>
+    <circle cx="${mood === "think" ? 25 : 23}" cy="29" r="3.2" fill="#1d2433"/><circle cx="${mood === "think" ? 45 : 43}" cy="29" r="3.2" fill="#1d2433"/>
+    <path d="${mouth}" stroke="var(--mascot-dark)" stroke-width="3" fill="none" stroke-linecap="round"/>
+    <path d="M32 58 q4 5 0 6 q-4-1 0-6" fill="#e05a5a"/>
+  </svg>`;
+}
+
+/* ---------- утилиты отрисовки ---------- */
+const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
+const norm = (s) => String(s).trim().replace(/\s+/g, " ");
+function typeChip(t) { return t === "int" ? '<span class="chip int">int · число</span>' : '<span class="chip str">str · текст</span>'; }
+function showVal(v) { return v.t === "str" ? `'${esc(v.v)}'` : esc(v.v); }
+
+function renderHeader() {
+  const names = ["1 · Кавычки", "2 · Программа ждёт", "3 · Цикл"];
+  document.getElementById("levels").innerHTML = names
+    .map((n, i) => `<span class="lv ${i < levelIdx ? "done" : i === levelIdx ? "cur" : ""}">${n}</span>`).join("");
+  const got = levelMistakes.slice(0, levelIdx).reduce((s, m) => s + starsFor(m), 0);
+  document.getElementById("stars").textContent = `★ ${got}`;
+}
+
+/* =====================================================================
+   УРОВЕНЬ 1. Кавычки. Ученик кликает по словам, чтобы поставить/снять
+   кавычки, и запускает программу. Значения подбираются случайно.
+   ===================================================================== */
+function quoteItems() {
+  const name = pick(["Оля", "Тимур", "Вика", "Артём", "Дана"]);
+  const city = pick(["Казань", "Пермь", "Омск", "Тула"]);
+  const age = randint(11, 17);
+  return [
+    { // имя в переменной
+      intro: `Сделай так, чтобы программа напечатала: <span class="target">Привет ${esc(name)}</span>`,
+      lines: [[{ v: "name" }, { s: " = " }, { q: name }], [{ s: "print(" }, { q: "Привет" }, { s: ", " }, { q: "name" }, { s: ")" }]],
+      target: `Привет ${name}`,
+    },
+    { // ловушка: нужно напечатать само слово city
+      intro: `А теперь напечатай само <b>слово</b> <span class="target">city</span> — не город`,
+      lines: [[{ v: "city" }, { s: " = " }, { q: city }], [{ s: "print(" }, { q: "city" }, { s: ")" }]],
+      target: "city",
+    },
+    { // число: кавычки не нужны, но и не ломают вывод
+      intro: `Нужно: <span class="target">Мне ${age}</span>`,
+      lines: [[{ v: "age" }, { s: " = " }, { q: String(age) }], [{ s: "print(" }, { q: "Мне" }, { s: ", " }, { q: "age" }, { s: ")" }]],
+      target: `Мне ${age}`,
+    },
+  ];
+}
+
+/* Мини-вычислитель ровно для этих двух форм строк: `имя = значение` и `print(арг, ...)`.
+   Это не интерпретатор Python — он знает только то, что задано в сценарии. */
+function runQuoteProgram(lines, quoted) {
+  const vars = {};
+  const out = [];
+  function evalTok(tok, key) {
+    const text = tok.q;
+    if (quoted.has(key)) return { ok: true, v: { v: text, t: "str" } };
+    if (/^\d+$/.test(text)) return { ok: true, v: { v: Number(text), t: "int" } };
+    if (text in vars) return { ok: true, v: vars[text] };
+    return { ok: false, err: `NameError: name '${text}' is not defined`, name: text };
+  }
+  for (let li = 0; li < lines.length; li++) {
+    const line = lines[li];
+    if (line[0].v) { // присваивание
+      const r = evalTok(line[2], `${li}:2`);
+      if (!r.ok) return { out, err: r.err, errName: r.name, line: li };
+      vars[line[0].v] = r.v;
+    } else { // print
+      const parts = [];
+      for (let ti = 0; ti < line.length; ti++) {
+        if (!line[ti].q) continue;
+        const r = evalTok(line[ti], `${li}:${ti}`);
+        if (!r.ok) return { out, err: r.err, errName: r.name, line: li };
+        parts.push(String(r.v.v));
+      }
+      out.push(parts.join(" "));
+    }
+  }
+  return { out, vars };
+}
+
+function level1() {
+  const items = quoteItems();
+  let k = 0;
+  let quoted = new Set();
+  let solved = false;
+  function codeHTML(item) {
+    return item.lines.map((line, li) => {
+      const toks = line.map((t, ti) => {
+        if (t.s) return esc(t.s);
+        if (t.v) return esc(t.v);
+        const key = `${li}:${ti}`;
+        const on = quoted.has(key);
+        return `<span class="tok q" tabindex="0" role="button" data-key="${key}" aria-label="поставить или снять кавычки">${on ? '"' : ""}${esc(t.q)}${on ? '"' : ""}</span>`;
+      }).join("");
+      return `<div class="ln"><span class="no">${li + 1}</span><span class="arrow"></span><span>${toks}</span></div>`;
+    }).join("");
+  }
+  function draw(feedback) {
+    const item = items[k];
+    const fb = feedback || { cls: "", mood: "happy", html: `${item.intro}<div class="why">Нажимай на подчёркнутые слова — кавычки появятся или исчезнут. Потом жми «Запустить».</div>` };
+    document.getElementById("main").innerHTML = `
+      <div class="grid">
+        <div class="card"><h2>Код · задание ${k + 1} из ${items.length}</h2><div class="code" id="code">${codeHTML(item)}</div>
+          <div class="console" id="console"><span class="dim">&gt;&gt;&gt; здесь появится вывод</span></div></div>
+        <div>
+          <div class="coach">${mascotSVG(fb.mood)}<div class="bubble ${fb.cls}">${fb.html}
+            <div class="row">${solved ? '<button class="primary" id="next">Дальше →</button>' : '<button class="primary" id="run">▶ Запустить</button>'}</div></div></div>
+        </div>
+      </div>`;
+    document.querySelectorAll(".tok.q").forEach((el) => {
+      const toggle = () => { if (solved) return; const key = el.dataset.key; quoted.has(key) ? quoted.delete(key) : quoted.add(key); draw(); };
+      el.addEventListener("click", toggle);
+      el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); } });
+    });
+    const run = document.getElementById("run");
+    if (run) run.onclick = () => check();
+    const next = document.getElementById("next");
+    if (next) next.onclick = () => { k++; quoted = new Set(); solved = false; stepStarted = performance.now(); if (k < items.length) draw(); else finishLevel(); };
+  }
+  function consoleShow(res) {
+    const c = document.getElementById("console");
+    let h = res.out.map((o) => esc(o)).join("<br>");
+    if (res.err) h += (h ? "<br>" : "") + `<span class="err">Traceback (most recent call last):<br>  File "main.py", line ${res.line + 1}, in &lt;module&gt;<br>${esc(res.err)}</span>`;
+    c.innerHTML = h || '<span class="dim">(ничего не напечатано)</span>';
+  }
+  function check() {
+    const item = items[k];
+    const res = runQuoteProgram(item.lines, quoted);
+    const got = res.out.join("\n");
+    const ok = !res.err && norm(got) === norm(item.target);
+    let html, misc = null;
+    if (ok) {
+      solved = true;
+      html = "<b>Работает!</b> ";
+      const ageTok = k === 2 && quoted.has("0:2");
+      if (ageTok) html += `Заметь: вывод тот же, но в <code>age</code> теперь лежит <b>текст</b> "${esc(item.lines[0][2].q)}", а не число. Прибавить к нему 1 уже не выйдет — числам кавычки не нужны.`;
+      else if (k === 1) html += "Без кавычек <code>city</code> — это имя ящика, где лежит город. В кавычках — просто буквы c-i-t-y.";
+      else html += "В кавычках — текст как есть. Без кавычек — имя переменной, Python достаёт из неё значение.";
+    } else if (res.err) {
+      misc = "quotes";
+      html = `<b>Python не знает имени <code>${esc(res.errName)}</code>.</b> Без кавычек слово — это имя переменной, а такой переменной никто не создавал. Если нужен сам текст — возьми его в кавычки.`;
+    } else {
+      misc = "quotes";
+      const wanted = norm(item.target), shown = norm(got);
+      html = `<b>Напечаталось <span class="target">${esc(shown)}</span>, а нужно <span class="target">${esc(wanted)}</span>.</b> `;
+      const quotedVarInPrint = item.lines[1].some((t, ti) => t.q && t.q === item.lines[0][0].v && quoted.has(`1:${ti}`));
+      html += quotedVarInPrint && k !== 1
+        ? `Ты взял имя переменной в кавычки — и Python напечатал само слово, а не то, что лежит в переменной.`
+        : `Посмотри на каждое слово в <code>print</code>: это текст как есть или имя ящика с данными?`;
+    }
+    if (misc) addMistake(misc);
+    logEvent({ level: 1, item: k + 1, kind: "quotes_run", ok, misconception: misc, quoted: [...quoted] });
+    consoleShow(res);
+    // перерисовываем только пузырь, консоль оставляем
+    const bubbleHost = document.querySelector(".coach");
+    bubbleHost.outerHTML = `<div class="coach">${mascotSVG(ok ? "happy" : "sad")}<div class="bubble ${ok ? "ok" : "bad"}">${html}
+      <div class="row">${ok ? '<button class="primary" id="next">Дальше →</button>' : '<button class="primary" id="run">▶ Запустить ещё раз</button>'}</div></div></div>`;
+    if (ok) {
+      document.getElementById("next").onclick = () => { k++; quoted = new Set(); solved = false; stepStarted = performance.now(); if (k < items.length) draw(); else finishLevel(); };
+      document.querySelectorAll(".tok.q").forEach((el) => el.replaceWith(Object.assign(document.createElement("span"), { textContent: el.textContent })));
+    } else {
+      document.getElementById("run").onclick = () => check();
+    }
+  }
+  draw();
+}
+
+/* =====================================================================
+   УРОВНИ 2–3. Пошаговый движок: код + память + консоль + вопрос перед
+   каждым шагом. Сценарий — список шагов; шаг описан данными и короткими
+   функциями-диагнозами (какую ошибку выдаёт этот неверный ответ).
+   ===================================================================== */
+function stepper(scn) {
+  const st = { vars: {}, order: [], console: [], waiting: null, flash: null };
+  let i = 0;
+  let locked = false;
+  const steps = scn.steps;
+
+  /* Варианты ответа перемешиваются один раз на шаг: верный не стоит всегда на одном месте. */
+  const optCache = new Map();
+  function stepOpts(step) {
+    if (!optCache.has(step.id)) {
+      const raw = typeof step.opts === "function" ? step.opts(st) : step.opts;
+      const arr = raw.slice();
+      for (let j = arr.length - 1; j > 0; j--) { const r = Math.floor(rng() * (j + 1)); [arr[j], arr[r]] = [arr[r], arr[j]]; }
+      optCache.set(step.id, arr);
+    }
+    return optCache.get(step.id);
+  }
+  function setVar(name, v, t) { if (!(name in st.vars)) st.order.push(name); st.vars[name] = { v, t }; st.flash = name; }
+  const api = { st, setVar, print: (s) => st.console.push({ s }), err: (s) => st.console.push({ s, err: true }) };
+
+  function draw(fb) {
+    const step = steps[i];
+    const line = typeof step.line === "function" ? step.line(st) : step.line;
+    const codeHTML = scn.code.map((l, li) => `<div class="ln ${li + 1 === line ? "cur" : ""}"><span class="no">${li + 1}</span><span class="arrow">${li + 1 === line ? "➜" : ""}</span><span>${esc(l)}</span></div>`).join("");
+    const memHTML = st.order.length
+      ? `<table><tr><th>имя</th><th>значение</th><th>тип</th></tr>${st.order.map((n) => `<tr class="${st.flash === n ? "flash" : ""}"><td class="val">${esc(n)}</td><td class="val">${showVal(st.vars[n])}</td><td>${typeChip(st.vars[n].t)}</td></tr>`).join("")}</table>`
+      : '<div class="empty">Пока пусто: переменные появятся, когда программа их создаст.</div>';
+    let con = st.console.map((c) => (c.err ? `<span class="err">${esc(c.s)}</span>` : esc(c.s))).join("<br>");
+    if (st.waiting !== null) con += (con ? "<br>" : "") + `${esc(st.waiting)}<input id="conIn" autocomplete="off" aria-label="ввод в консоль"><span class="cursor"></span>`;
+    st.flash = null;
+
+    const q = typeof step.q === "function" ? step.q(st) : step.q;
+    let body = `<div class="q">${q}</div>`;
+    if (fb) body += `<div class="why">${fb.html}</div>`;
+    if (fb && fb.ok) body += `<div class="row"><button class="primary" id="next">${i + 1 < steps.length ? "Дальше →" : "Завершить уровень →"}</button></div>`;
+    else if (step.kind === "choice") {
+      const opts = stepOpts(step);
+      body += `<div class="opts">${opts.map((o, oi) => `<button data-oi="${oi}" ${fb && fb.tried && fb.tried.has(oi) ? "disabled" : ""}>${o.t}</button>`).join("")}</div>`;
+    } else if (step.kind === "value") {
+      body += `<div class="row"><input class="ans" id="ans" autocomplete="off" placeholder="${esc(step.ph || "твой ответ")}"><button class="primary" id="go">Проверить</button></div>`;
+    }
+    document.getElementById("main").innerHTML = `
+      <div class="grid">
+        <div class="card"><h2>${esc(scn.title)}</h2><div class="code">${codeHTML}</div>
+          <div class="console" aria-live="polite">${con || '<span class="dim">консоль пуста</span>'}</div></div>
+        <div>
+          <div class="card mem"><h2>Память программы</h2>${memHTML}</div>
+          <div class="coach">${mascotSVG(fb ? (fb.ok ? "happy" : fb.neutral ? "think" : "sad") : "think")}<div class="bubble ${fb ? (fb.ok ? "ok" : fb.neutral ? "" : "bad") : ""}">${body}</div></div>
+        </div>
+      </div>`;
+    const next = document.getElementById("next");
+    if (next) { next.onclick = advance; next.focus(); }
+    document.querySelectorAll("[data-oi]").forEach((b) => (b.onclick = () => answerChoice(Number(b.dataset.oi), fb)));
+    const go = document.getElementById("go");
+    if (go) {
+      const ans = document.getElementById("ans");
+      go.onclick = () => answerValue(ans.value);
+      ans.addEventListener("keydown", (e) => { if (e.key === "Enter") answerValue(ans.value); });
+      ans.focus();
+    }
+    const conIn = document.getElementById("conIn");
+    if (conIn && step.kind === "console") {
+      conIn.focus();
+      conIn.addEventListener("keydown", (e) => { if (e.key === "Enter") answerConsole(conIn.value); });
+    }
+  }
+  function good(html) { draw({ ok: true, html }); }
+  function answerChoice(oi, prevFb) {
+    if (locked) return;
+    const step = steps[i];
+    const o = stepOpts(step)[oi];
+    const tried = prevFb && prevFb.tried ? prevFb.tried : new Set();
+    logEvent({ level: levelIdx + 1, step: step.id, kind: "choice", answer: o.t.replace(/<[^>]+>/g, ""), ok: !!o.ok, misconception: o.ok ? null : o.m || null });
+    if (o.ok) { if (step.after) step.after(api, o); good(o.why || "Верно!"); return; }
+    addMistake(o.m || step.m);
+    tried.add(oi);
+    draw({ ok: false, html: o.why, tried });
+  }
+  function answerValue(raw) {
+    const step = steps[i];
+    const res = step.check(norm(raw), st);
+    logEvent({ level: levelIdx + 1, step: step.id, kind: "value", answer: raw, ok: res.ok, misconception: res.ok ? null : res.m || step.m || null });
+    if (res.ok) { if (step.after) step.after(api, raw); good(res.why || "Верно!"); return; }
+    addMistake(res.m || step.m);
+    draw({ ok: false, html: res.why });
+  }
+  function answerConsole(raw) {
+    const step = steps[i];
+    const res = step.check(raw.trim(), st);
+    logEvent({ level: levelIdx + 1, step: step.id, kind: "console", answer: raw, ok: res.ok, misconception: res.ok ? null : res.m || null });
+    if (res.ok) { st.console.push({ s: st.waiting + raw.trim() }); st.waiting = null; if (step.after) step.after(api, raw.trim()); good(res.why); return; }
+    if (res.crash) { // программа упала по-настоящему (так сделал бы Python): показываем и запускаем строку заново
+      st.console.push({ s: st.waiting + raw.trim() });
+      res.crash.forEach((s) => api.err(s));
+      st.console.push({ s: "— настоящий Python начал бы программу сначала; в тренажёре продолжаем с этой строки —" });
+    }
+    if (res.m) addMistake(res.m);
+    draw({ ok: false, neutral: !res.m, html: res.why });
+  }
+  function advance() {
+    i++;
+    stepStarted = performance.now();
+    if (i >= steps.length) { finishLevel(); return; }
+    if (steps[i].before) steps[i].before(api);
+    draw();
+  }
+  if (steps[0].before) steps[0].before(api);
+  draw();
+}
+
+/* ---------- сценарий уровня 2: input / int / типы; вариант выбирается случайно ---------- */
