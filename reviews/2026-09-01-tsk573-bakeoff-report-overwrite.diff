+def report_path(outdir: pathlib.Path, stem: str, *, partial: bool) -> pathlib.Path:
+    """Куда писать отчёт: полный прогон — в файл дня, частичный — в свой файл.
+
+    Имя, собранное из одной даты, плюс `write_text` = молчаливая перезапись.
+    01.09 точечный прогон `--models x-ai/grok-4.5 --runs 3` снёс месячный разбор
+    на 345 строк, оставив вместо него табличку на одну строку; спасло только то,
+    что отчёт был закоммичен (tsk-573). Полный прогон отчёт дня перезаписывать
+    вправе — он его и составлял. Частичный замер по заданному вручную списку
+    чужой работой распоряжаться не должен: он меряет выборку, а не набор.
+    """
+    outdir.mkdir(parents=True, exist_ok=True)
+    if partial:
+        return outdir / f"{datetime.now():%Y-%m-%d-%H%M%S}-{stem}-partial.md"
+    path = outdir / f"{date.today():%Y-%m-%d}-{stem}.md"
+    if path.exists():
+        print(f"ВНИМАНИЕ: полный прогон ПЕРЕЗАПИШЕТ существующий отчёт дня: {path}")
+    return path
+
+
+def partial_note(models: list[str]) -> list[str]:
+    """Шапка частичного отчёта: чтобы его не приняли за разбор всего набора."""
+    names = ", ".join(f"`{m}`" for m in models)
+    return [
+        f"> **Частичный прогон.** Мерялись только заданные `--models`: {names}. "
+        "Это не разбор всего каталога и не замена отчёту дня — выводы верны "
+        "лишь для перечисленных моделей. Отчёт дня этот прогон не трогал.",
+        "",
+    ]
+
+
+def no_good_hint(results: list[dict], *, partial: bool) -> str:
+    """Строка «годных нет» — совет только там, где он осмыслен.
+
+    Раньше здесь всегда стояло «проверить баланс/квоту ключа». При прогоне по
+    одному кандидату, забракованному по формату, совет был ложным: баланс был в
+    порядке (`credits=5.06`), просто выборка состояла из одной негодной модели.
+    """
+    if all(a["ok_runs"] == 0 for a in results):
+        return ("- ни одна модель не ответила вообще — проверить баланс/квоту ключа "
+                "и доступность провайдера")
+    if partial:
+        return ("- среди заданных `--models` годных нет: модели ответили, но забракованы "
+                "по вердиктам выше. Это оценка выборки, а не каталога")
+    return "- нет ни одного: модели отвечают, но все забракованы по вердиктам выше"
+
+
