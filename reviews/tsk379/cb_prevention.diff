 URL_RE = re.compile(r"https?://[^\s<>)\"']+", re.IGNORECASE)
+
+# tsk-379 (LMS): автор канала предваряет разбор служебной шапкой вида «Задание
+# 24_24613 КЕГЭ. Уровень сложный.» или «Задание 9 Сборник Крылова С.С. вариант 3.
+# Уровень средний.» — это его собственная привычка форматирования поста, а не
+# артефакт скрейпа/OCR, поэтому чистка стоит здесь (на входе в LMS-импорт), а не в
+# web_stem_hygiene.py/stem_hygiene.py (те режут мусор конкретно со страниц
+# источников и PDF-разметки). Уровень сложности дублирует difficulty_id
+# (канон — сам пост, tsk-381/tsk-382); внутренний ID/название сборника ученику
+# не нужны. Приземлённый прод-мусор чинился LMS `scripts/tsk379_fix_stems.py` —
+# тот же паттерн вырезки (не «от маркера до конца», урок tsk-370: если после
+# шапки в том же абзаце сразу идёт реальный вопрос через <br>, срезаем только
+# шапку и один соседний <br>, остальное оставляем).
+_LEVEL_WORD = r"(?:простой|лёгкий|легкий|средний|сложный)"
+_HEADER_LEADER = r"(?:Решение\s+задания|Задание)"
+_WHOLE_HEADER_P_RE = re.compile(
+    rf"<p>\s*{_HEADER_LEADER}\s+(?:<br\s*/?>|[^<])*?Уровень\s+{_LEVEL_WORD}\.?\s*</p>\s*",
+    re.IGNORECASE,
+)
+_INLINE_HEADER_RE = re.compile(
+    rf"{_HEADER_LEADER}\s+(?:<br\s*/?>|[^<])*?Уровень\s+{_LEVEL_WORD}\.?\s*(?:<br\s*/?>\s*)?",
+    re.IGNORECASE,
+)
+_HTML_TAG_RE = re.compile(r"<[^>]+>")
+
+
+def strip_operator_header(html_body: str) -> str:
+    """Условие без служебной шапки «Задание … Уровень X» / «Решение задания N …».
+
+    Применяется к УЖЕ собранному HTML (после ``text_to_html``), а не к сырому
+    телу поста: шапка и реальный текст иногда делят один абзац через ``<br>``,
+    а границы абзацев к этому моменту уже расставлены.
+
+    Если после среза от условия не осталось видимого текста — шапка была ВСЕМ
+    телом поста (нет самого разбора, только идентификатор), срез откатывается:
+    пустой stem хуже, чем оставшаяся шапка, и такой пост нужен ручному разбору.
+    """
+    out = _INLINE_HEADER_RE.sub("", _WHOLE_HEADER_P_RE.sub("", html_body))
+    if not _HTML_TAG_RE.sub("", out).strip():
+        return html_body
+    return out
+
+
