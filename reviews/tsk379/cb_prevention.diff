+def test_strip_operator_header_whole_paragraph() -> None:
+    # tsk-379: шапка — весь первый абзац, реальный разбор идёт отдельным <p>.
+    html = text_to_html(
+        "Задание 24_24613 КЕГЭ. Уровень сложный.\n\nОпределите количество строк.")
+    cleaned = strip_operator_header(html)
+    assert "Уровень" not in cleaned
+    assert "24_24613" not in cleaned
+    assert "Определите количество строк." in cleaned
+
+
+def test_strip_operator_header_krylov_variant() -> None:
+    html = text_to_html(
+        "Задание 9 Сборник Крылова С.С. вариант 3. Уровень средний.\n\n"
+        "Исполнитель Черепаха действует на плоскости.")
+    cleaned = strip_operator_header(html)
+    assert "Сборник Крылова" not in cleaned
+    assert "Исполнитель Черепаха действует на плоскости." in cleaned
+
+
+def test_strip_operator_header_inline_same_paragraph() -> None:
+    # Шапка и вопрос в одном абзаце через перенос строки (<br> после сборки HTML).
+    html = text_to_html("Задание 6_83164 РешуЕГЭ. Уровень средний\nИсполнитель Черепаха.")
+    cleaned = strip_operator_header(html)
+    assert "Уровень" not in cleaned
+    assert "Исполнитель Черепаха." in cleaned
+
+
+def test_strip_operator_header_keeps_body_when_header_is_all_there_is() -> None:
+    # Пост — только идентификатор, разбора нет: пустой stem хуже шапки, откат.
+    html = text_to_html("Задание 12_25239 КЕГЭ. Уровень средний.")
+    assert strip_operator_header(html) == html
+
+
+def test_strip_operator_header_no_marker_is_noop() -> None:
+    html = text_to_html("Обычный текст без служебной шапки.")
+    assert strip_operator_header(html) == html
+
+
