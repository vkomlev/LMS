+        ("material", tree["intro"]), ("material", tree["cm"]), ("task", tree["ct"]),
+        ("material", tree["after"]), ("task", tree["rt"]), ("task", tree["rt2"]),
+    ]
+
+
+@pytest.mark.asyncio
+async def test_syllabus_after_section(db, tree, flag_on):
