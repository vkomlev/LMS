diff --git a/components/marketer/SubscriptionSummary.tsx b/components/marketer/SubscriptionSummary.tsx
new file mode 100644
index 0000000..8e604c8
--- /dev/null
+++ b/components/marketer/SubscriptionSummary.tsx
@@ -0,0 +1,236 @@
+"use client";
+
+import { useState } from "react";
+
+import { Button } from "@/components/ui/button";
+import { StatusBadge } from "@/components/ui/status-badge";
+import { getApiErrorMessage } from "@/lib/api-error-messages";
+import { formatShortDate } from "@/lib/format-date";
+import { SCHOOL_TIME_ZONE } from "@/lib/time-zone";
+import type { StudentBrief } from "@/lib/marketer/use-marketer-leads";
+import {
+  useSubscriptionSummary,
+  useSubscriptionSummaryStudents,
+  type SubscriptionSummaryRow,
+  type SubscriptionSummaryStudent,
+} from "@/lib/marketer/use-marketer-subscriptions";
+
+/**
+ * tsk-619 — кто на каком тарифе и кто без тарифа.
+ *
+ * Панель Фазы 9 отвечает на вопрос про конкретного человека: найти поиском,
+ * посмотреть, сменить. Сводка отвечает на предыдущий вопрос — кого вообще
+ * стоит открыть. `demo` даётся при регистрации, `base` при появлении
+ * расписания, и между этими событиями человек живёт неделями, невидимый ни на
+ * одном экране: список расчётной цены показывает только тех, кто стоит денег,
+ * а у Demo, Test и «Выпускника» тарифной группы нет.
+ *
+ * Строка разворачивается в список людей, из списка человек открывается в той
+ * же панели рядом — иначе сводка осталась бы картинкой, из которой ничего
+ * нельзя сделать.
+ */
+export function SubscriptionSummary({
+  onPickStudent,
+}: {
+  onPickStudent: (student: StudentBrief) => void;
+}) {
+  const summary = useSubscriptionSummary();
+  const [openRow, setOpenRow] = useState<string | null>(null);
+
+  return (
+    <section
+      data-testid="marketer-subscription-summary"
+      className="space-y-3 rounded-md border border-border bg-card p-3"
+    >
+      <header className="space-y-1">
+        <h2 className="text-base font-medium">Раскладка по тарифам</h2>
+        <p className="text-xs text-muted-foreground">
+          {summary.data === undefined
+            ? "Сколько учеников на каждом тарифе и кто остался без тарифа."
+            : `Всего учеников: ${summary.data.total_students}. Считается на ${formatShortDate(
+                summary.data.as_of,
+                SCHOOL_TIME_ZONE,
+              )}. «Засиделся» — дольше ${summary.data.long_standing_days} дней на одном тарифе.`}
+        </p>
+      </header>
+
+      {summary.isPending && (
+        <p className="text-sm text-muted-foreground">Загружаем раскладку…</p>
+      )}
+      {summary.isError && (
+        <p className="text-sm text-destructive" data-testid="marketer-subscription-summary-error">
+          {getApiErrorMessage(summary.error).title}
+        </p>
+      )}
+
+      {summary.data !== undefined && (
+        <ul className="space-y-2">
+          {summary.data.rows.map((row) => (
+            <SummaryRow
+              key={row.plan_code ?? "__no_plan__"}
+              row={row}
+              isOpen={openRow === rowKey(row)}
+              onToggle={() => setOpenRow(openRow === rowKey(row) ? null : rowKey(row))}
+              onPickStudent={onPickStudent}
+            />
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
+
+function rowKey(row: SubscriptionSummaryRow): string {
+  return row.plan_code ?? "__no_plan__";
+}
+
+function SummaryRow({
+  row,
+  isOpen,
+  onToggle,
+  onPickStudent,
+}: {
+  row: SubscriptionSummaryRow;
+  isOpen: boolean;
+  onToggle: () => void;
+  onPickStudent: (student: StudentBrief) => void;
+}) {
+  const empty = row.students === 0;
+
+  return (
+    <li className="rounded-md border border-border/60 bg-background/40 p-2">
+      <button
+        type="button"
+        // Имя кнопки называет ТАРИФ, а не «Показать»: одинаковые подписи у
+        // девяти строк неразличимы ни глазами, ни живым прогоном (tsk-491/505).
+        aria-label={`Ученики на тарифе ${row.plan_name}`}
+        data-testid={`marketer-subscription-summary-row-${rowKey(row)}`}
+        onClick={onToggle}
+        disabled={empty}
+        className="flex w-full flex-wrap items-center gap-2 text-left disabled:cursor-default"
+      >
+        <span className="min-w-0 flex-1 space-y-1">
+          <span className="flex flex-wrap items-center gap-2">
+            <span className="text-sm font-medium">{row.plan_name}</span>
+            <StatusBadge tone={badgeTone(row)}>{row.students}</StatusBadge>
+          </span>
+          <span className="block text-xs text-muted-foreground">{describeRow(row)}</span>
+        </span>
+        {!empty && (
+          <span aria-hidden className="shrink-0 text-xs text-muted-foreground">
+            {isOpen ? "свернуть" : "показать"}
+          </span>
+        )}
+      </button>
+
+      {isOpen && !empty && (
+        <RowStudents planCode={row.plan_code} onPickStudent={onPickStudent} />
+      )}
+    </li>
+  );
+}
+
+function badgeTone(row: SubscriptionSummaryRow) {
+  if (row.students === 0) return "info" as const;
+  // «Без тарифа» — не нейтральная строка: пока тарифа нет, ИИ-наставник и
+  // разбор с преподавателем ученику закрыты.
+  if (row.plan_code === null) return "danger" as const;
+  if (row.long_standing > 0 || row.with_overdue_payment > 0) return "waiting" as const;
+  return "success" as const;
+}
+
+/** Что видно за числом: где деньги, где расписание, где повод открыть человека. */
+function describeRow(row: SubscriptionSummaryRow): string {
+  if (row.students === 0) {
+    return row.plan_code === null ? "Все ученики с тарифом" : "Никого";
+  }
+  const parts = [
+    row.pricing_group_name
+      ? `счёт по группе «${row.pricing_group_name}»`
+      : "начисления не создаются",
+    `с расписанием ${row.with_schedule} из ${row.students}`,
+  ];
+  if (row.long_standing > 0) parts.push(`засиделись: ${row.long_standing}`);
+  if (row.with_overdue_payment > 0) {
+    parts.push(`просрочена оплата: ${row.with_overdue_payment}`);
+  }
+  return parts.join(" · ");
+}
+
+function RowStudents({
+  planCode,
+  onPickStudent,
+}: {
+  planCode: string | null;
+  onPickStudent: (student: StudentBrief) => void;
+}) {
+  const students = useSubscriptionSummaryStudents(planCode);
+
+  return (
+    <div className="mt-2 space-y-2 border-t border-border/60 pt-2">
+      {students.isPending && (
+        <p className="text-xs text-muted-foreground">Загружаем учеников…</p>
+      )}
+      {students.isError && (
+        <p className="text-xs text-destructive">{getApiErrorMessage(students.error).title}</p>
+      )}
+      <ul className="space-y-2" data-testid="marketer-subscription-summary-students">
+        {(students.data ?? []).map((student) => (
+          <StudentLine key={student.student_id} student={student} onPick={onPickStudent} />
+        ))}
+      </ul>
+    </div>
+  );
+}
+
+function StudentLine({
+  student,
+  onPick,
+}: {
+  student: SubscriptionSummaryStudent;
+  onPick: (student: StudentBrief) => void;
+}) {
+  const name = (student.full_name ?? "").trim() || `Без имени · #${student.student_id}`;
+
+  return (
+    <li className="flex flex-wrap items-center gap-2">
+      <span className="min-w-0 flex-1 space-y-0.5">
+        <span className="block text-sm">{name}</span>
+        <span className="block text-xs text-muted-foreground">
+          {describeStudent(student)}
+        </span>
+      </span>
+      <Button
+        variant="ghost"
+        size="sm"
+        // В имени кнопки стоит ИМЯ ученика: строк в списке много, и «Открыть»
+        // у каждой указывало бы в никуда при проверке живьём.
+        aria-label={`Открыть тариф: ${name}`}
+        onClick={() => onPick({ id: student.student_id, full_name: student.full_name })}
+      >
+        Открыть тариф
+      </Button>
+    </li>
+  );
+}
+
+/**
+ * Две даты рядом намеренно: строки подписок моложе самой школы (модель тарифов
+ * заведена 07–09.08.2026), поэтому «на тарифе 3 дня» у человека, который учится
+ * с мая, — правда о тарифе, а не о нём. Без даты регистрации такую строку
+ * прочитали бы как «новичок».
+ */
+function describeStudent(student: SubscriptionSummaryStudent): string {
+  const parts: string[] = [`#${student.student_id}`];
+  if (student.plan_since !== null && student.days_on_plan !== null) {
+    parts.push(
+      `на тарифе с ${formatShortDate(student.plan_since, SCHOOL_TIME_ZONE)} (${student.days_on_plan} дн.)`,
+    );
+  } else {
+    parts.push("тарифа нет");
+  }
+  parts.push(`в школе с ${formatShortDate(student.registered_on, SCHOOL_TIME_ZONE)}`);
+  parts.push(student.has_schedule ? "есть расписание" : "нет расписания");
+  if (student.has_overdue_payment) parts.push("просрочена оплата");
+  return parts.join(" · ");
+}
