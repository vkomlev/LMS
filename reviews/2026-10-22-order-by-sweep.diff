+async def _per_plan(db, students: dict[str, int], call) -> dict[str, Any]:
+    """Под каждым планом — вызов на СВОЁМ ученике (вызов меняет его состояние)."""
+    seen: dict[str, Any] = {}
+    for plan in PLANS:
+        seen[plan] = await with_plan(db, plan, lambda: call(students[plan]))
