+def _ranked(ids: list[int]) -> list[int]:
+    """Ожидаемый порядок при чередовании «сильный/слабый» по индексу: сначала
+    чётные (сильнее), затем нечётные — внутри групп по id."""
+    return ids[0::2] + ids[1::2]
