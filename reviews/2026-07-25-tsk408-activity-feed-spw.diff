index 0000000..8e2dcab
--- /dev/null
+++ b/lib/teacher/use-activity-feed.ts
@@ -0,0 +1,48 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import type { components } from "@/lib/api-types";
+import { useApiClient } from "@/hooks/use-api-client";
+import { useCurrentUser } from "@/hooks/use-current-user";
+
+/**
+ * tsk-408 — лента активности учеников преподавателя: решение задания
+ * (успешно/неуспешно/на проверке), запрос помощи, изучение материала —
+ * единый поток по всем ученикам, топ-N по убыванию времени.
+ *
+ * Отличие от `use-help-requests.ts`: тот список — то, что ждёт ДЕЙСТВИЯ
+ * учителя (inbox), эта лента — просто поток произошедшего, без обязательства
+ * реагировать (tsk-303 остаётся отдельной задачей).
+ */
+export type ActivityFeedResponse = components["schemas"]["ActivityFeedResponse"];
+export type ActivityFeedEvent = components["schemas"]["ActivityFeedEvent"];
+
+const PAGE_SIZE = 100;
+
+/** GET /teacher/activity-feed — первая страница (последние `PAGE_SIZE` событий). */
+export function useActivityFeed() {
+  const client = useApiClient();
+  const { data: user } = useCurrentUser();
+  const teacherId = user?.id ?? null;
+
+  return useQuery<ActivityFeedResponse>({
+    queryKey: ["teacher", "activity-feed", teacherId],
+    queryFn: () =>
+      client.get<ActivityFeedResponse>(
+        `/api/v1/teacher/activity-feed?limit=${PAGE_SIZE}`,
+      ),
+    enabled: teacherId != null,
+    staleTime: 15 * 1_000,
+    retry: false,
+  });
+}
+
+/** GET /teacher/activity-feed?before=... — следующая страница («показать ещё»). */
+export async function fetchOlderActivity(
+  client: ReturnType<typeof useApiClient>,
+  before: string,
+): Promise<ActivityFeedResponse> {
+  return client.get<ActivityFeedResponse>(
+    `/api/v1/teacher/activity-feed?limit=${PAGE_SIZE}&before=${encodeURIComponent(before)}`,
+  );
+}
