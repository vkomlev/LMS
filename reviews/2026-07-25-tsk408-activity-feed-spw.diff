index 0000000..2d18eca
--- /dev/null
+++ b/components/teacher/ActivityFeed.tsx
@@ -0,0 +1,188 @@
+"use client";
+
+import { useState } from "react";
+import { CheckCircle2, XCircle, Clock, HelpCircle, BookOpen, User } from "lucide-react";
+import { cn } from "@/lib/utils";
+import { readApiErrorMessage } from "@/lib/auth/error-utils";
+import { LoadingState } from "@/components/reliability/LoadingState";
+import { TaskHistoryTrigger } from "@/components/task-history/TaskHistoryTrigger";
+import { useApiClient } from "@/hooks/use-api-client";
+import {
+  useActivityFeed,
+  fetchOlderActivity,
+  type ActivityFeedEvent,
+} from "@/lib/teacher/use-activity-feed";
+
+/**
+ * tsk-408 — лента активности: единый поток событий по всем ученикам
+ * преподавателя (решение задания, запрос помощи, изучение материала),
+ * топ-100 по убыванию времени. Не листать каждого ученика отдельно.
+ *
+ * Клик по событию про задание переиспользует `TaskHistoryTrigger` (tsk-406) —
+ * ту же боковую карточку, что и на экране прогресса/заявок/очереди. Событие
+ * про материал не кликабельно (детальной карточки материала в кабинете нет).
+ *
+ * «Показать ещё» — курсорная пагинация по времени (`before`), а не offset:
+ * лента собрана слиянием трёх независимых источников, единого offset у них нет.
+ */
+export function ActivityFeed() {
+  const client = useApiClient();
+  const q = useActivityFeed();
+  const [older, setOlder] = useState<ActivityFeedEvent[]>([]);
+  const [cursor, setCursor] = useState<string | null>(null);
+  const [hasMore, setHasMore] = useState(false);
+  const [loadingMore, setLoadingMore] = useState(false);
+  const [loadMoreError, setLoadMoreError] = useState<string | null>(null);
+
+  const firstPage = q.data?.events ?? [];
+  const events = [...firstPage, ...older];
+  const effectiveHasMore = older.length > 0 ? hasMore : (q.data?.has_more ?? false);
+  const effectiveCursor = older.length > 0 ? cursor : (q.data?.next_before ?? null);
+
+  async function loadMore() {
+    if (!effectiveCursor) return;
+    setLoadingMore(true);
+    setLoadMoreError(null);
+    try {
+      const page = await fetchOlderActivity(client, effectiveCursor);
+      setOlder((prev) => [...prev, ...page.events]);
+      setCursor(page.next_before ?? null);
+      setHasMore(page.has_more);
+    } catch (e) {
+      setLoadMoreError(readApiErrorMessage(e, "Не удалось загрузить более старые события."));
+    } finally {
+      setLoadingMore(false);
+    }
+  }
+
+  return (
+    <div className="space-y-3">
+      {q.isLoading && (
+        <LoadingState testId="activity-feed-loading">Загружаем ленту…</LoadingState>
+      )}
+      {q.isError && (
+        <p data-testid="activity-feed-error" className="text-sm text-destructive" role="alert">
+          {readApiErrorMessage(q.error, "Не удалось загрузить ленту активности.")}
+        </p>
+      )}
+
+      {!q.isLoading && !q.isError && events.length === 0 && (
+        <div
+          data-testid="activity-feed-empty"
+          className="flex flex-col items-center gap-3 rounded-lg border border-border bg-card px-6 py-12 text-center"
+        >
+          <Clock className="h-9 w-9 text-muted-foreground" aria-hidden />
+          <p className="text-sm text-muted-foreground">Пока нет событий.</p>
+        </div>
+      )}
+
+      {events.length > 0 && (
+        <ul className="space-y-2" data-testid="activity-feed-list">
+          {events.map((e, i) => (
+            <ActivityCard key={`${e.type}-${e.student_id}-${e.timestamp}-${i}`} event={e} />
+          ))}
+        </ul>
+      )}
+
+      {loadMoreError && (
+        <p role="alert" className="text-sm text-destructive">
+          {loadMoreError}
+        </p>
+      )}
+
+      {effectiveHasMore && (
+        <button
+          type="button"
+          data-testid="activity-feed-load-more"
+          disabled={loadingMore}
+          onClick={() => void loadMore()}
+          className="w-full rounded-md border border-border px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground disabled:opacity-60"
+        >
+          {loadingMore ? "Загружаем…" : "Показать ещё"}
+        </button>
+      )}
+    </div>
+  );
+}
+
+const TYPE_META: Record<
+  ActivityFeedEvent["type"],
+  { icon: typeof BookOpen; badge: string; label: string }
+> = {
+  task_solved: { icon: CheckCircle2, badge: "", label: "Задание" },
+  help_requested: {
+    icon: HelpCircle,
+    badge: "bg-amber-500/10 text-amber-700 dark:text-amber-300",
+    label: "Помощь",
+  },
+  material_studied: {
+    icon: BookOpen,
+    badge: "bg-slate-500/10 text-slate-700 dark:text-slate-300",
+    label: "Материал",
+  },
+};
+
+function outcomeBadge(event: ActivityFeedEvent): { icon: typeof CheckCircle2; className: string } {
+  if (event.type === "task_solved") {
+    if (event.outcome === "correct") {
+      return { icon: CheckCircle2, className: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300" };
+    }
+    if (event.outcome === "incorrect") {
+      return { icon: XCircle, className: "bg-red-500/10 text-red-700 dark:text-red-300" };
+    }
+    return { icon: Clock, className: "bg-blue-500/10 text-blue-700 dark:text-blue-300" };
+  }
+  const meta = TYPE_META[event.type];
+  return { icon: meta.icon, className: meta.badge };
+}
+
+function ActivityCard({ event }: { event: ActivityFeedEvent }) {
+  const meta = TYPE_META[event.type];
+  const { icon: BadgeIcon, className: badgeClassName } = outcomeBadge(event);
+  const when = new Date(event.timestamp).toLocaleString("ru-RU", {
+    day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit",
+  });
+  const canOpenTaskHistory = event.type !== "material_studied" && event.task_id != null;
+
+  return (
+    <li
+      data-testid="activity-card"
+      data-event-type={event.type}
+      data-student-id={event.student_id}
+      className="flex flex-col gap-1.5 rounded-lg border border-border bg-card p-3"
+    >
+      <div className="flex items-center justify-between gap-2">
+        <span className="inline-flex items-center gap-1.5 text-sm font-medium">
+          <User className="h-4 w-4 text-muted-foreground" aria-hidden />
+          {event.student_name ?? `Ученик #${event.student_id}`}
+        </span>
+        <span
+          className={cn(
+            "inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium",
+            badgeClassName,
+          )}
+        >
+          <BadgeIcon className="h-3 w-3" aria-hidden />
+          {meta.label}
+        </span>
+      </div>
+
+      {canOpenTaskHistory ? (
+        <TaskHistoryTrigger
+          studentId={event.student_id}
+          taskId={event.task_id}
+          className="truncate text-sm text-muted-foreground"
+        >
+          {event.summary}
+        </TaskHistoryTrigger>
+      ) : (
+        <span className="truncate text-sm text-muted-foreground">{event.summary}</span>
+      )}
+
+      <span className="inline-flex items-center gap-1 text-xs text-muted-foreground">
+        <Clock className="h-3.5 w-3.5" aria-hidden />
+        {when}
+      </span>
+    </li>
+  );
+}
