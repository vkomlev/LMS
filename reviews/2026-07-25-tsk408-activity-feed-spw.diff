@@ -0,0 +1,170 @@
+/**
+ * @vitest-environment jsdom
+ * tsk-408 — лента активности учеников преподавателя: рендер карточек по типу
+ * события, клик по task_solved/help_requested открывает TaskHistoryTrigger,
+ * material_studied не кликабелен, курсорная пагинация «показать ещё».
+ */
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { render, screen, fireEvent, waitFor } from "@testing-library/react";
+
+const useActivityFeed = vi.fn();
+const fetchOlderActivity = vi.fn();
+vi.mock("@/lib/teacher/use-activity-feed", () => ({
+  useActivityFeed: () => useActivityFeed(),
+  fetchOlderActivity: (...args: unknown[]) => fetchOlderActivity(...args),
+}));
+
+const useApiClientMock = vi.fn(() => ({ get: vi.fn(), post: vi.fn() }));
+vi.mock("@/hooks/use-api-client", () => ({
+  useApiClient: (...args: unknown[]) => useApiClientMock(...args),
+}));
+
+const useStudentTaskHistory = vi.fn();
+vi.mock("@/lib/task-history/use-task-history", () => ({
+  useStudentTaskHistory: (...args: unknown[]) => useStudentTaskHistory(...args),
+}));
+
+import { ActivityFeed } from "@/components/teacher/ActivityFeed";
+
+const solvedEvent = {
+  type: "task_solved",
+  student_id: 142,
+  student_name: "Иванов Иван",
+  task_id: 110,
+  material_id: null,
+  course_id: 5,
+  timestamp: "2026-07-25T10:00:00Z",
+  summary: "Иванов Иван — решил задание «Задание 110» (верно)",
+  outcome: "correct",
+};
+
+const failedEvent = {
+  type: "task_solved",
+  student_id: 143,
+  student_name: "Петров Пётр",
+  task_id: 111,
+  material_id: null,
+  course_id: 5,
+  timestamp: "2026-07-25T09:00:00Z",
+  summary: "Петров Пётр — решил задание «Задание 111» (неверно)",
+  outcome: "incorrect",
+};
+
+const helpEvent = {
+  type: "help_requested",
+  student_id: 142,
+  student_name: "Иванов Иван",
+  task_id: 205,
+  material_id: null,
+  course_id: 5,
+  timestamp: "2026-07-25T08:00:00Z",
+  summary: "Иванов Иван — запросил помощь по заданию «Задание 205»",
+  outcome: "open",
+};
+
+const materialEvent = {
+  type: "material_studied",
+  student_id: 142,
+  student_name: "Иванов Иван",
+  task_id: null,
+  material_id: 77,
+  course_id: 5,
+  timestamp: "2026-07-25T07:00:00Z",
+  summary: "Иванов Иван — изучил материал «Введение»",
+  outcome: null,
+};
+
+describe("ActivityFeed", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    useStudentTaskHistory.mockReturnValue({ isLoading: false, isError: false, data: undefined });
+  });
+
+  it("показывает загрузку", () => {
+    useActivityFeed.mockReturnValue({ isLoading: true, isError: false, data: undefined });
+    render(<ActivityFeed />);
+    expect(screen.getByTestId("activity-feed-loading")).toBeInTheDocument();
+  });
+
+  it("показывает ошибку", () => {
+    useActivityFeed.mockReturnValue({ isLoading: false, isError: true, error: null, data: undefined });
+    render(<ActivityFeed />);
+    expect(screen.getByTestId("activity-feed-error")).toBeInTheDocument();
+  });
+
+  it("пустая лента", () => {
+    useActivityFeed.mockReturnValue({
+      isLoading: false, isError: false,
+      data: { events: [], has_more: false, next_before: null },
+    });
+    render(<ActivityFeed />);
+    expect(screen.getByTestId("activity-feed-empty")).toBeInTheDocument();
+  });
+
+  it("рендерит события всех трёх типов с бейджами", () => {
+    useActivityFeed.mockReturnValue({
+      isLoading: false, isError: false,
+      data: { events: [solvedEvent, failedEvent, helpEvent, materialEvent], has_more: false, next_before: null },
+    });
+    render(<ActivityFeed />);
+    const cards = screen.getAllByTestId("activity-card");
+    expect(cards).toHaveLength(4);
+    expect(cards[0]).toHaveAttribute("data-event-type", "task_solved");
+    expect(cards[2]).toHaveAttribute("data-event-type", "help_requested");
+    expect(cards[3]).toHaveAttribute("data-event-type", "material_studied");
+    expect(screen.getByText(/решил задание «Задание 110» \(верно\)/)).toBeInTheDocument();
+    expect(screen.getByText(/решил задание «Задание 111» \(неверно\)/)).toBeInTheDocument();
+  });
+
+  it("клик по task_solved открывает карточку истории задания", () => {
+    useActivityFeed.mockReturnValue({
+      isLoading: false, isError: false,
+      data: { events: [solvedEvent], has_more: false, next_before: null },
+    });
+    render(<ActivityFeed />);
+    expect(screen.queryByTestId("task-history-sheet")).not.toBeInTheDocument();
+    fireEvent.click(screen.getByTestId("task-history-trigger"));
+    expect(screen.getByTestId("task-history-sheet")).toBeInTheDocument();
+    expect(useStudentTaskHistory).toHaveBeenCalledWith(142, 110, { enabled: true });
+  });
+
+  it("material_studied не кликабелен (нет task-history-trigger)", () => {
+    useActivityFeed.mockReturnValue({
+      isLoading: false, isError: false,
+      data: { events: [materialEvent], has_more: false, next_before: null },
+    });
+    render(<ActivityFeed />);
+    expect(screen.queryByTestId("task-history-trigger")).not.toBeInTheDocument();
+    expect(screen.getByText(/изучил материал «Введение»/)).toBeInTheDocument();
+  });
+
