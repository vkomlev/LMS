+        raise HelpClaimConflictError(
+            "Заявку уже взял другой преподаватель",
+            claimed_by=claimed_by,
+            claimed_by_name=claimed_by_name,
+            claim_expires_at=claim_expires_at,
+        )
+
+    due_at = _aware(urow[8])
+    item = {
