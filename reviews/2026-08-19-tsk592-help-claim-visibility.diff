+    claimed_by = row[1]
+    claim_expires_at = _aware(claim_expires_raw)
+    if not acl_ok:
+        raise HelpClaimForbiddenError()
+    if hr_status != "open":
+        raise HelpClaimConflictError("Заявка уже закрыта")
