+        "request_type": urow[2],
+        "student_id": urow[3],
+        "task_id": urow[4],
+        "course_id": urow[5],
+        "created_at": urow[6],
+        "priority": urow[7] if urow[7] is not None else 100,
+        "due_at": due_at,
+        "is_overdue": due_at is not None and due_at < now,
+    }
+    previous_claim = (
