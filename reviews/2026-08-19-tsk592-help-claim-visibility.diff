+    urow = r2.fetchone()
+    if urow is None:
+        logger.info(
+            "help_claim_by_id conflict request_id=%s teacher_id=%s claimed_by=%s expires=%s",
+            request_id, teacher_id, claimed_by, claim_expires_at,
