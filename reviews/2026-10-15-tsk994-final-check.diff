+        text(
+            "INSERT INTO task_results (user_id, task_id, attempt_id, score, max_score, "
+            "  is_correct, submitted_at, received_at, count_retry, source_system) "
+            "VALUES (:u, :t, :a, 1, 1, true, now(), now(), 0, 'manual_teacher')"
+        ),
