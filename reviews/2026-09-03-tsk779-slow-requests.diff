+        ``"background"`` — порог не превышен нигде.
+    """
+    if fresh_worst_sec >= ALERT_SECONDS or fresh_hour_n >= ALERT_BURST:
+        return "active"
+    if worst_sec >= ALERT_SECONDS or burst_n >= ALERT_BURST:
+        return "resolved"
+    return "background"
+
 
