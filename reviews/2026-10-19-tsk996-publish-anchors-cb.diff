+def _publish(
+    monkeypatch, *, anchors: bool, warnings: Optional[list] = None, republish: bool = False,
+    existing: Optional[set] = None, skipped_manual: Optional[list] = None,
+):
+    import content_hub_client.client as hub_mod
+    import monolith.lms_client as lms_mod
+
+    monkeypatch.setattr(lms_mod, "LMSClient", _FakeLMS)
+    monkeypatch.setattr(hub_mod, "ContentHubClient", _FakeHub)
+    _FakeLMS.sent = []
+    _FakeLMS.warnings = list(warnings or [])
+    _FakeLMS.existing = set(existing or ())
+    _FakeLMS.skipped_manual = list(skipped_manual or [])
+    doc = _doc([_h2("A"), _p("теория a"), _q("a"), _h2("B"), _p("теория b"), _q("b")])
+    return LessonLmsPublisher().publish(
+        [build_lesson_plan(doc)], _CFG, anchors=anchors, republish=republish,
+    )
+
