new file mode 100644
index 0000000..fd25465
--- /dev/null
+++ b/tests/test_tsk996_publish_anchors.py
@@ -0,0 +1,388 @@
+# tsk-996 (фаза C, ADR-0008 LMS): публикатор передаёт якорь задания к материалу его H2-раздела.
+#
+# Задание стоит в уроке под каким-то H2-разделом; материал этого раздела в LMS —
+# `{base}#m{N}`. Публикатор шлёт у задания `anchor_external_uid` = этот uid, и LMS
+# ставит задание сразу после материала (чередование теории и практики). Номер
+# раздела обязан совпадать с номером материала из `build_materials` — проверяется
+# здесь на краевых случаях (вводный материал, контрольные точки П9, ведущий H2 =
+# названию урока, lms_skip, подкурсы). Плюс флаг `--no-anchors` и предупреждения LMS.
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+from typing import Any, Optional
+
+_root = Path(__file__).resolve().parent.parent
+if str(_root) not in sys.path:
+    sys.path.insert(0, str(_root))
+
+from monolith.lms_client.contracts import LMSClientResult, task_payload_to_dict
+from monolith.lms_publish.blocks_to_lms import (
+    build_lesson_plan,
+    build_materials,
+    extract_lms_tasks,
+    to_task_payloads,
+)
+from monolith.lms_publish.lesson_publisher import LessonLmsPublisher
+from monolith.wp_publish.blocks import parse_content_doc
+
+BASE = "authored:tsk996:lesson"
+
+
+def _h2(text: str, **extra: Any) -> dict:
+    return {"type": "heading", "level": 2, "text": text, **extra}
+
+
+def _p(text: str) -> dict:
+    return {"type": "paragraph", "html": text}
+
+
+def _q(stem: str, **extra: Any) -> dict:
+    return {"type": "control_question", "qtype": "SA", "stem": stem, "answer": "1", **extra}
+
+
+def _task(stem: str) -> dict:
+    return {"type": "task", "ttype": "SA", "stem": stem, "answer": "42"}
+
+
+def _cp(stem: str) -> dict:
+    return {"type": "control_question", "qtype": "SA", "stem": stem, "answer": "да",
+            "lms_checkpoint": True}
+
+
+def _doc(blocks: list[dict], title: str = "Урок про якоря", **extra: Any):
+    return parse_content_doc({
+        "kind": "lesson", "title": title, "global_uid": BASE,
+        "course_slug": "tsk996", "blocks": blocks, **extra,
+    })
+
+
+def _anchors(doc) -> dict[str, Optional[str]]:
+    """Стем задания → якорь (uid материала) — читаемее, чем по номерам."""
+    return {t.task_content["stem"]: t.anchor_material_uid for t in extract_lms_tasks(doc)}
+
+
+def _material_of(doc, uid: str) -> str:
+    """HTML материала с данным external_uid (проверка «якорь — на раздел задания»)."""
+    return next(m.html for m in build_materials(doc) if m.external_uid == uid)
+
+
+# --- извлечение якоря ------------------------------------------------------
+
+
+def test_theory_tasks_theory_tasks_anchor_to_own_sections():
+    """«Теория — задания — теория — задания»: задания каждого раздела — на его материал."""
+    doc = _doc([
+        _h2("Циклы"), _p("теория циклов"), _q("цикл 1"), _task("цикл 2"),
+        _h2("Функции"), _p("теория функций"), _q("функция 1"), _task("функция 2"),
+    ])
+    assert [m.external_uid for m in build_materials(doc)] == [f"{BASE}#m1", f"{BASE}#m2"]
+    assert _anchors(doc) == {
+        "цикл 1": f"{BASE}#m1", "цикл 2": f"{BASE}#m1",
+        "функция 1": f"{BASE}#m2", "функция 2": f"{BASE}#m2",
+    }
+    assert "теория циклов" in _material_of(doc, f"{BASE}#m1")
+    assert "теория функций" in _material_of(doc, f"{BASE}#m2")
+
+
+def test_lesson_without_h2_has_no_anchors():
+    """Урок без H2 — один материал, якорей нет, поля в payload нет."""
+    doc = _doc([_p("теория"), _q("вопрос"), _p("ещё теория"), _task("задача")])
+    assert len(build_materials(doc)) == 1
+    assert _anchors(doc) == {"вопрос": None, "задача": None}
+    plan = build_lesson_plan(doc)
+    assert all("anchor_external_uid" not in task_payload_to_dict(p) for p in to_task_payloads(plan, 7))
+
+
+def test_task_before_first_h2_has_no_anchor_and_intro_takes_m1():
+    """Вводная теория до H2 — материал #m1; задание до первого H2 якоря не получает,
+    а первый H2-раздел — это #m2 (номер сверен с build_materials)."""
+    doc = _doc([
+        _p("вводная"), _q("до раздела"),
+        _h2("Раздел"), _p("теория раздела"), _q("в разделе"),
+        _h2("Итог"), _p("итог"), _q("в итоге"),
+    ])
+    assert [m.external_uid for m in build_materials(doc)] == [f"{BASE}#m1", f"{BASE}#m2", f"{BASE}#m3"]
+    assert _anchors(doc) == {"до раздела": None, "в разделе": f"{BASE}#m2", "в итоге": f"{BASE}#m3"}
+    assert "теория раздела" in _material_of(doc, f"{BASE}#m2")
+
+
+def test_checkpoints_do_not_shift_section_numbers():
+    """Контрольные точки П9 номер раздела не занимают — ни до первого H2, ни внутри раздела."""
+    doc = _doc([
+        _cp("точка до всего"),
+        _h2("Первый"), _p("теория 1"), _cp("точка 1"), _q("после точки 1"),
+        _h2("Второй"), _p("теория 2"), _cp("точка 2"), _task("после точки 2"),
+    ])
+    materials = build_materials(doc)
+    assert [m.external_uid for m in materials] == [f"{BASE}#m1", f"{BASE}#m2"]
+    assert _anchors(doc) == {"после точки 1": f"{BASE}#m1", "после точки 2": f"{BASE}#m2"}
+    assert "теория 2" in _material_of(doc, f"{BASE}#m2")
+    # Точки — в материалах, а не в заданиях.
+    assert len(extract_lms_tasks(doc)) == 2
+
+
+def test_title_heading_and_lms_skip_heading_do_not_open_section():
+    """Ведущий H2 = названию урока снимается и раздел не открывает; H2 с lms_skip —
+    тоже (его текст в LMS не идёт). Номер якоря — номер реального материала."""
+    doc = _doc([
+        _h2("Урок про якоря"), _p("вступление"), _q("под заголовком урока"),
+        _h2("Раздел А"), _p("теория А"), _q("в А"),
+        _h2("Только для сайта", lms_skip=True), _p("теория А, продолжение"), _q("после skip-H2"),
+        _h2("Раздел Б"), _p("теория Б"), _q("в Б"),
+    ])
+    uids = [m.external_uid for m in build_materials(doc)]
+    assert uids == [f"{BASE}#m1", f"{BASE}#m2", f"{BASE}#m3"]
+    assert _anchors(doc) == {
+        "под заголовком урока": None,
+        "в А": f"{BASE}#m2",
+        "после skip-H2": f"{BASE}#m2",
+        "в Б": f"{BASE}#m3",
+    }
+    assert "теория Б" in _material_of(doc, f"{BASE}#m3")
+
+
+def test_h3_does_not_open_section():
+    """Подзаголовок H3 — часть раздела: во вводной части якоря не даёт, в H2-разделе
+    якорь прежний."""
+    h3 = {"type": "heading", "level": 3, "text": "Пример"}
+    doc = _doc([
+        _p("вводная"), dict(h3), _p("пример во вводной"), _q("после H3 во вводной"),
+        _h2("Раздел"), _p("теория"), dict(h3), _p("пример"), _q("после H3"),
+        _h2("Итог"), _p("итог"), _q("в итоге"),
+    ])
+    assert _anchors(doc) == {
+        "после H3 во вводной": None, "после H3": f"{BASE}#m2", "в итоге": f"{BASE}#m3",
+    }
+
+
+def test_anchor_uses_uid_base_and_task_uid_version():
+    """Якорь строится от той же базы, что и материалы (lms_uid_base), версия ключей
+    заданий (tsk-1284) на якорь не влияет."""
+    doc = _doc([_h2("Раздел"), _p("теория"), _q("вопрос"), _h2("Итог"), _p("итог"), _q("итог")],
+               lms_task_uid_version="v2")
+    plan = build_lesson_plan(doc, lms_uid_base="wp:node-base")
+    assert plan.materials[0].external_uid == "wp:node-base#m1"
+    assert plan.tasks[0].external_uid == "wp:node-base#v2q1"
+    assert plan.tasks[0].anchor_material_uid == "wp:node-base#m1"
+
+
+def test_subcourse_tasks_anchor_to_own_node_materials():
+    """У подкурса своя база: якоря его заданий — на материалы этого же подкурса."""
+    two = [_h2("Раздел 1"), _p("теория 1"), _q("в 1"), _h2("Раздел 2"), _p("теория 2"), _q("в 2")]
+    doc = _doc(two, subcourses=[{"course_uid": "wp:sub", "title": "Подкурс", "blocks": two}])
+    plan = build_lesson_plan(doc)
+    assert plan.tasks[0].anchor_material_uid == f"{BASE}#m1"
+    sub = plan.subcourses[0]
+    assert [t.anchor_material_uid for t in sub.tasks] == ["wp:sub#m1", "wp:sub#m2"]
+    assert {m.external_uid for m in sub.materials} == {"wp:sub#m1", "wp:sub#m2"}
+
+
+def test_tasks_only_after_last_section_get_no_anchors():
+    """Нет чередования (все задания в последнем разделе) — якорей нет: иначе они
+    поднялись бы над подкурсами узла, хотя в уроке стоят в конце (ADR-0008)."""
+    doc = _doc([
+        _h2("A"), _p("теория a"), _h2("B"), _p("теория b"), _q("в конце 1"), _task("в конце 2"),
+    ])
+    assert len(build_materials(doc)) == 2
+    assert _anchors(doc) == {"в конце 1": None, "в конце 2": None}
+    # Одно задание до первого H2 + остальные в последнем разделе — тоже не чередование.
+    doc = _doc([_p("вводная"), _q("вводный"), _h2("A"), _p("теория a"), _q("в конце")])
+    assert _anchors(doc) == {"вводный": None, "в конце": None}
