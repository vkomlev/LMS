+def test_cli_flag_no_anchors_reaches_run(monkeypatch):
+    """`--no-anchors` в парсере → anchors=False в run_lms_publish_lessons."""
+    from monolith.cli import lms as cli_lms
+    from monolith.app_cli.main import COMMANDS
+    from monolith.cli.parser import build_arg_parser
+
+    def build_parser():
+        return build_arg_parser(COMMANDS)
+
+    args = build_parser().parse_args(["lms-publish-lesson", "--global-uid", "g", "--no-anchors"])
+    assert args.no_anchors is True
+    seen: dict = {}
+
+    def fake_run(cfg, run_id, **kwargs):
+        seen.update(kwargs)
+        return {"status": "success", "report": {}}
+
+    monkeypatch.setattr(cli_lms, "run_lms_publish_lessons", fake_run)
+    handler = cli_lms._cmd_lms_publish_lesson  # noqa: SLF001
+    handler(args, {}, "rid")
+    assert seen["anchors"] is False
+    args = build_parser().parse_args(["lms-publish-lesson", "--global-uid", "g"])
+    handler(args, {}, "rid")
+    assert seen["anchors"] is True
+
