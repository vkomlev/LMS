+class _FakeLMS:
+    """LMS-клиент публикатора: записывает пакеты заданий, отдаёт предупреждения."""
+
+    sent: list = []
+    warnings: list = []
+    existing: set = set()
+    skipped_manual: list = []
+
+    def __init__(self, *a: Any, **k: Any) -> None:
+        pass
+
+    def get_difficulty_levels(self):
+        return LMSClientResult(ok=True, data=[{"id": 2, "code": "EASY"}, {"id": 3, "code": "NORMAL"}])
+
+    def get_course_by_code(self, code):
+        return LMSClientResult(ok=True, data={"id": 7})
+
+    def bulk_upsert_materials(self, payloads):
+        return LMSClientResult(ok=True, data={"items": [
+            {"external_uid": p.external_uid, "material_id": 100 + i} for i, p in enumerate(payloads)
+        ]})
+
+    def find_tasks_by_external(self, uids):
+        return LMSClientResult(ok=True, data={"items": [
+            {"external_uid": u, "id": 1} for u in uids if u in _FakeLMS.existing
+        ]})
+
+    def bulk_upsert_tasks(self, payloads, *, mode=None, force_uids=None, published_at=None):
+        _FakeLMS.sent.append([task_payload_to_dict(p) for p in payloads])
+        return LMSClientResult(ok=True, data={
+            "skipped_manually_edited": list(_FakeLMS.skipped_manual),
+            "results": [
+                {"external_uid": p.external_uid, "id": 200 + i, "action": "created"}
+                for i, p in enumerate(payloads)
+            ],
+            "warnings": list(_FakeLMS.warnings),
+        })
+
+    def get_materials_by_course(self, course_id, query=None):
+        return LMSClientResult(ok=True, data={"items": []})
+
+    def get_tasks_by_course(self, course_id):
+        return LMSClientResult(ok=True, data=[])
+
+    def get_course_children(self, parent_id):
+        return LMSClientResult(ok=True, data=[])
