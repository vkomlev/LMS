+        raise DomainError("Хранилище файлов недоступно", status_code=503) from exc
+    except BotoCoreError as exc:
+        logger.error("tsk-593: ошибка соединения с S3 key=%r err=%s", key, exc)
+        raise DomainError("Хранилище файлов недоступно", status_code=503) from exc
