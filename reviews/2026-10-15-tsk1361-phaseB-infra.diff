+SELECT DISTINCT uc.user_id
+  FROM user_courses uc
+  JOIN up ON up.node_id = uc.course_id
+  JOIN student_requirement_sync rs ON rs.student_id = uc.user_id
+ WHERE uc.is_active
+   AND up.changed_at > rs.synced_at - CAST(:margin AS interval)
+"""
