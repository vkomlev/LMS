+    @staticmethod
+    def _fraction_digits(number: str) -> int:
+        """Количество цифр после десятичного разделителя («1.00» → 2, «5» → 0)."""
+        for sep in ".,":
+            if sep in number:
+                return len(number.split(sep, 1)[1])
+        return 0
