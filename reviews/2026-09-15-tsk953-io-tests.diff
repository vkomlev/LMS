+MAX5_CODE = (
+    "n = int(input())\nm = 0\nfor i in range(n):\n    x = int(input())\n"
+    "    if x % 5 == 0 and x > m:\n        m = x\nprint(m)\n"
+)
+MAX5_GENEXP_CODE = (
