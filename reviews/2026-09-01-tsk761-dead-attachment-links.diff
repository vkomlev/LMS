+# Второй класс дефекта (tsk-761): файл к заданию ЕСТЬ и лежит в CAS, но рядом, внутри
+# текста условия, остался ИСХОДНЫЙ якорь источника — `href="/get_file?id=191284"` у
+# sdamgia или `href="ege-txt/10-260.docx"` у kpolyakov. На нашем домене такой путь ведёт
+# в никуда: ученик жмёт «Задание 26» и получает 404.
+#
+# Почему проверка выше его не видит: она признаёт задание благополучным по одному
+# наличию ссылки `/api/v1/media/...` — а здесь она есть, рабочая, в шапке. Дефект живёт
+# НЕ в отсутствии файла, а в лишней ссылке рядом с ним, поэтому нужен отдельный запрос.
+# На 2026-09-01 таких заданий на проде было 86 (курсы 153, 1381-1402).
+#
+# Что считаем битым: ссылка на файл ДАННЫХ (или sdamgia-`get_file`), которая не абсолютна
+# (`http(s)://` — чужой сайт открывается у ученика нормально, решение tsk-390 про авторские
+# файлы на victor-komlev.ru) и не ведёт в наше хранилище `/api/v1/media/`.
+SQL_DEAD_FILE_LINKS = rf"""
+WITH links AS (
+    SELECT t.id, t.course_id, t.external_uid,
+           (regexp_matches(t.task_content->>'stem', 'href="\s*([^"]+)"', 'g'))[1] AS href
+    FROM tasks t
+    WHERE t.is_active
+      AND t.task_content->>'stem' ~ 'href="'
+)
+SELECT id, course_id, external_uid, href,
+       CASE WHEN href ~* '^https?://' THEN 'на сайт-источник' ELSE 'в никуда (404)' END AS kind
+FROM links
+WHERE href !~ '^/api/v1/media/'
+  AND (
+        -- относительный путь чужого сайта: у нас это 404
+        (href !~* '^https?://' AND (href ~* '\.({DATA_EXT})$' OR href ~ '^/get_file'))
+        -- абсолютная ссылка на сайт-источник: открывается, но уводит ученика туда,
+        -- где рядом лежит решение с ответом (класс tsk-165), и зависит от чужого сайта
+        OR href ~* '^https?://[^"]*(sdamgia\.ru|kpolyakov\.spb\.ru|kompege\.ru)[^"]*(get_file|\.({DATA_EXT}))'
+      )
+ORDER BY course_id, id
+"""
+
 
