diff --git a/lib/learning/use-my-requirement.ts b/lib/learning/use-my-requirement.ts
new file mode 100644
index 0000000..c09e9ee
--- /dev/null
+++ b/lib/learning/use-my-requirement.ts
@@ -0,0 +1,32 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+import type { components } from "@/lib/api-types";
+import { useApiClient } from "@/hooks/use-api-client";
+
+export type MyRequirement = components["schemas"]["MyRequirementRead"];
+
+/**
+ * tsk-1361: уровень задания/материала для текущего ученика и причина.
+ *
+ * `GET /api/v1/me/requirement` — тот же уровень, что у программы курса и
+ * «следующего шага». `TaskRead`/`MaterialRead` отдают уровень курса, одинаковый
+ * для всех, поэтому для бейджа и кнопки «Пропустить» берётся этот ответ.
+ * Пока он грузится или упал — страница показывает уровень курса, как раньше.
+ */
+export function useMyRequirement(
+  kind: "task" | "material",
+  itemId: number | null | undefined,
+) {
+  const client = useApiClient();
+  const param = kind === "task" ? "task_id" : "material_id";
+  return useQuery<MyRequirement>({
+    queryKey: ["learning", "my-requirement", kind, itemId],
+    queryFn: () => client.get<MyRequirement>(`/api/v1/me/requirement?${param}=${itemId}`),
+    enabled: itemId != null,
+    // Уровень может смениться после сдачи (правила пересчитываются фоном в
+    // пределах минуты) — держим недолго.
+    staleTime: 30_000,
+    retry: false,
+  });
+}
diff --git a/lib/teacher/use-student-progress.ts b/lib/teacher/use-student-progress.ts
index 78825a1..234484f 100644
--- a/lib/teacher/use-student-progress.ts
+++ b/lib/teacher/use-student-progress.ts
@@ -370,3 +370,84 @@ export function useCloseBlockedLimitRequest(
     },
   });
 }
+
+// ---------------------------------------------------------------------------
+// tsk-1361: обязательность элемента или темы для ученика
+// ---------------------------------------------------------------------------
+
+export type RequirementTargetKind = "task" | "material" | "course";
+export type RequirementChangeResponse = components["schemas"]["RequirementChangeResponse"];
+
+interface RequirementSetVars {
+  targetKind: RequirementTargetKind;
+  targetId: number;
+  level: "required" | "recommended";
+  comment?: string;
+}
+
+/**
+ * PUT /progress/requirement — решение преподавателя об обязательности.
+ * Главнее правил (новизна, сокращение программы); повторный вызов заменяет
+ * прежнее решение. Ученик видит итог с причиной.
+ */
+export function useSetRequirement(
+  studentId: number | null | undefined,
+  courseId: number | null | undefined,
+) {
+  const client = useApiClient();
+  const qc = useQueryClient();
+  return useMutation<RequirementChangeResponse, Error, RequirementSetVars>({
+    mutationFn: ({ targetKind, targetId, level, comment }) =>
+      client.put<RequirementChangeResponse>(
+        `${progressBase(studentId as number)}/requirement`,
+        { target_kind: targetKind, target_id: targetId, level, comment: comment || null },
+      ),
+    onSuccess: () => {
+      void qc.invalidateQueries({ queryKey: studentProgressKey(studentId, courseId) });
+    },
+  });
+}
+
+/** DELETE /progress/requirement — снять решение: элемент вернётся к курсу и правилам. */
+export function useRevokeRequirement(
+  studentId: number | null | undefined,
+  courseId: number | null | undefined,
+) {
+  const client = useApiClient();
+  const qc = useQueryClient();
+  return useMutation<
+    RequirementChangeResponse,
+    Error,
+    { targetKind: RequirementTargetKind; targetId: number }
+  >({
+    mutationFn: ({ targetKind, targetId }) =>
+      client.delete<RequirementChangeResponse>(
+        `${progressBase(studentId as number)}/requirement?target_kind=${targetKind}&target_id=${targetId}`,
+      ),
+    onSuccess: () => {
+      void qc.invalidateQueries({ queryKey: studentProgressKey(studentId, courseId) });
+    },
+  });
+}
+
+/**
+ * GET /progress/requirement/preview — сколько обязательных элементов задевает
+ * решение по теме. Учитель видит масштаб ДО сохранения. `nodeCourseId=null` —
+ * запрос не идёт.
+ */
+export function useRequirementPreview(
+  studentId: number | null | undefined,
+  nodeCourseId: number | null,
+) {
+  const client = useApiClient();
+  return useQuery<RequirementChangeResponse>({
+    queryKey: ["teacher", "requirement-preview", studentId, nodeCourseId],
+    queryFn: () =>
+      client.get<RequirementChangeResponse>(
+        `${progressBase(studentId as number)}/requirement/preview?target_kind=course&target_id=${nodeCourseId}`,
+      ),
+    enabled: studentId != null && nodeCourseId != null,
+    staleTime: 30_000,
+    retry: false,
+  });
+}
