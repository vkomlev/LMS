+def resolve_student_owner(
+    current_user: CurrentUser,
+    student_id: int | None,
+    *,
+    subject: str,
+) -> int:
+    """Кому принадлежит запрошенное — ученику из сессии или названному явно.
+
+    Ботам (TG_LMS) ученика взять неоткуда: они ходят по сервисному ключу, и
+    `get_current_user` отдаёт им `CurrentUser(id=0, is_service=True)`. Без явного
+    параметра данные всех учеников слились бы в одного несуществующего
+    пользователя 0.
+
+    Страж: параметр читается ТОЛЬКО у сервисного вызывающего. Обычный ученик,
+    подставивший чужой номер, получает 403 — иначе это сквозная дыра, дающая
+    читать чужое по подобранному числу.
+
+    Правило живёт здесь одной копией намеренно: оно повторяется на каждой
+    поверхности, доступной боту, и разъехавшись хоть в одной, дало бы дыру
+    ровно там, где её никто не ищет.
+
+    :param current_user: вызывающий (ученик или сервисный ключ).
+    :param student_id: явно названный ученик; допустим только сервисному вызову.
+    :param subject: чего лишится вызов без параметра («разговор ничей»).
+    :return: идентификатор ученика-владельца.
+    """
+    if student_id is None:
+        if current_user.is_service:
+            raise HTTPException(
+                status.HTTP_400_BAD_REQUEST,
+                f"сервисный вызов обязан указать student_id — иначе {subject}",
+            )
+        return current_user.id
+    if not current_user.is_service:
+        raise HTTPException(
+            status.HTTP_403_FORBIDDEN,
+            "student_id доступен только сервисному вызову",
+        )
+    return student_id
+
+
