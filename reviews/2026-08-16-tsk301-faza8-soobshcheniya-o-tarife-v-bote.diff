--- /dev/null
+++ b/src/common/entitlements_client.py
@@ -0,0 +1,116 @@
+"""Права тарифа для бота (tsk-301, фаза 8).
+
+Бот показывает остаток обращений к наставнику и объясняет, что даёт другой
+тариф. Все пороги, названия и предупреждения считает LMS — здесь только запрос
+и мягкая деградация.
+
+**Почему не считать у себя.** Порог предупреждения («осталось мало») и правило
+продажи пакета — продуктовые величины, они меняются без выката бота. Свой
+счётчик однажды назвал бы другое число, чем сайт и письмо, и это выглядело бы
+как сбой, а не как разная настройка.
+
+**Почему `student_id` в запросе.** Бот ходит по сервисному ключу, своего
+`current_user` у него нет. На стороне LMS параметр читается ТОЛЬКО у сервисного
+вызова: обычному ученику он даёт 403 — иначе чужой тариф и остаток смотрел бы
+любой, кто подберёт число.
+
+**Почему сбой не показывается ученику.** Витрина — украшение кнопки, а не
+разрешение. Реальный гейт стоит в LMS на самом действии: если остаток не
+доехал, ученик просто увидит кнопку без счётчика, а не отказ.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+import aiohttp
+
+from src.common.config import settings
+
+logger = logging.getLogger(__name__)
+
+_TIMEOUT = aiohttp.ClientTimeout(total=5, sock_connect=3)
+
+
+class CapabilityView:
+    """Состояние одной возможности: доступна ли, сколько осталось, что даст апгрейд."""
+
+    def __init__(self, raw: dict[str, Any]) -> None:
+        self.allowed: bool = bool(raw.get("allowed"))
+        # allowed | denied_no_plan | denied_not_in_plan | denied_limit
+        self.reason: str = str(raw.get("reason") or "")
+        self.limit: Optional[int] = raw.get("limit")
+        self.remaining: Optional[int] = raw.get("remaining")
+        self.warn: bool = bool(raw.get("warn"))
+        self.upgrade_hint: Optional[str] = raw.get("upgrade_hint")
+
+
+class EntitlementsView:
+    """Витрина прав ученика — то же, что видит веб-кабинет."""
+
+    def __init__(self, raw: dict[str, Any]) -> None:
+        self.plan_code: Optional[str] = raw.get("plan_code")
+        self.plan_name: Optional[str] = raw.get("plan_name")
+        self.capabilities: dict[str, CapabilityView] = {
+            name: CapabilityView(value)
+            for name, value in (raw.get("capabilities") or {}).items()
+            if isinstance(value, dict)
+        }
+
+    def capability(self, name: str) -> Optional[CapabilityView]:
+        return self.capabilities.get(name)
+
+
+def _url(path: str) -> str:
+    return f"{str(settings.api_url).rstrip('/')}{path}"
+
+
+async def fetch_entitlements(student_id: int) -> Optional[EntitlementsView]:
+    """Забрать права ученика. None — если LMS не ответила; это не ошибка для ученика."""
+    try:
+        async with aiohttp.ClientSession(timeout=_TIMEOUT) as session:
+            async with session.get(
+                _url("/api/v1/me/entitlements"),
+                headers={"X-API-Key": str(settings.api_key)},
+                params={"student_id": str(student_id)},
+            ) as resp:
+                if resp.status != 200:
+                    logger.warning(
+                        "entitlements: LMS ответила %s (student_id=%s)",
+                        resp.status, student_id,
+                    )
+                    return None
+                raw = await resp.json()
+    except Exception as exc:  # noqa: BLE001 — витрина не роняет диалог
+        logger.warning(
+            "entitlements: не удалось получить права (student_id=%s): %s",
+            student_id, exc,
+        )
+        return None
+    if not isinstance(raw, dict):
+        return None
+    return EntitlementsView(raw)
+
+
+def tutor_button_label(view: Optional[EntitlementsView]) -> str:
+    """Подпись кнопки наставника: остаток и предупреждение до исчерпания.
+
+    Без витрины — прежняя нейтральная подпись: молчание лучше выдуманного числа.
+    Когда наставник в тариф не входит, кнопка обещает не разбор, а объяснение —
+    иначе ученик нажмёт и упрётся в отказ.
+    """
+    base = "🤔 Разобраться с наставником"
+    tutor = view.capability("ai_tutor") if view else None
+    if tutor is None:
+        return base
+    if tutor.reason == "denied_limit":
+        # Обещать разбор нечестно: обращения на месяц кончились. Но и прятать
+        # кнопку нельзя — за ней объяснение, как получить ещё.
+        return "🤔 Наставник: обращения на месяц кончились"
+    if not tutor.allowed:
+        return "🤔 Наставник: что это и как открыть"
+    if tutor.remaining is None:
+        return base  # безлимит — считать нечего
+    if tutor.warn:
+        return f"{base} (осталось {tutor.remaining})"
+    return f"{base} ({tutor.remaining} в этом месяце)"
diff --git a/src/common/utils/dialogs.py b/src/common/utils/dialogs.py
index 094d685..fc4e614 100644
--- a/src/common/utils/dialogs.py
+++ b/src/common/utils/dialogs.py
@@ -38,6 +38,38 @@ class APIErrorMapping:
     is_time_limit: bool = False
     is_attempt_finished: bool = False
     is_attempt_limit: bool = False
+    is_subscription_denied: bool = False
+
+
+SUBSCRIPTION_DENIED_CODE = "subscription_denied"
+
+# Запасной текст: тариф отказал, а объяснения в теле не оказалось. Пустая
+# строка тут превратилась бы в «недоступно» без причины — тупик, ради ухода от
+# которого весь разбор и делается.
+MSG_SUBSCRIPTION_DENIED_FALLBACK = (
+    "Это не входит в твой тариф. Напиши преподавателю — он подскажет, "
+    "какой тариф открывает эту возможность."
+)
+
+
+def _subscription_denied_hint(error: Exception) -> str | None:
+    """Достать объяснение из отказа по тарифу; None — если отказ не про тариф.
+
+    Признак берём машинный (`payload.code`), а не по тексту: сообщения меняются
+    вместе с продуктовой формулировкой, а код — нет.
+    """
+    body = getattr(error, "body", None)
+    if not isinstance(body, dict):
+        return None
+    payload = body.get("payload")
+    if not isinstance(payload, dict):
+        return None
+    if payload.get("code") != SUBSCRIPTION_DENIED_CODE:
+        return None
+    detail = body.get("detail") or payload.get("upgrade_hint")
+    if isinstance(detail, str) and detail.strip():
+        return detail.strip()
+    return MSG_SUBSCRIPTION_DENIED_FALLBACK
 
 
 def map_api_error_to_user_message(
@@ -54,6 +86,15 @@ def map_api_error_to_user_message(
     error_msg = str(error).strip().lower()
     status_code = getattr(error, "status_code", None)
 
+    # tsk-301: отказ по тарифу — не «недостаточно прав». Прав у ученика ровно
+    # столько, сколько он купил, и единственный полезный ответ здесь — что даёт
+    # переход на другой тариф. Текст берём из тела отказа: пороги и названия
+    # тарифов считает LMS, и если бот начнёт складывать свои, однажды он назовёт
+    # другую цифру, чем сайт, — это выглядит как сбой счётчика.
+    hint = _subscription_denied_hint(error)
+    if hint:
+        return APIErrorMapping(user_message=hint, is_subscription_denied=True)
+
     if status_code == 404:
         return APIErrorMapping(user_message=MSG_OBJECT_NOT_FOUND)
     if status_code == 403:
diff --git a/tests/unit/test_tsk301_tariff_messages.py b/tests/unit/test_tsk301_tariff_messages.py
new file mode 100644
index 0000000..a3fb33c
--- /dev/null
+++ b/tests/unit/test_tsk301_tariff_messages.py
@@ -0,0 +1,199 @@
+"""tsk-301 фаза 8: что видит ученик в боте, когда упирается в тариф.
+
+Проверяется главный разрыв: отказ по тарифу и сбой сервиса — разные события,
+а бот показывал их одинаково. «Наставник недоступен, это сбой на нашей стороне»
+на тарифе без наставника — неправда: ученик подождёт и нажмёт снова вместо того,
+чтобы узнать, что даёт другой тариф. Второй такой же тупик — «Недостаточно прав»
+на запрос помощи преподавателя.
+
+Пороги и тексты считает LMS. Тесты следят, чтобы бот их доносил, а не считал
+свои: разойдясь, веб и бот назвали бы разные числа, и это выглядело бы как сбой
+счётчика, а не как разная настройка.
+"""
+from __future__ import annotations
+
+import inspect
+
+from src.bots.common.dialogs import student_attempts_base as sab
+from src.common.ai_tutor_client import (
+    DEGRADED_TEXT,
+    DENIED_FALLBACK_TEXT,
+    TutorReply,
+    VISIBILITY_NOTICE,
+    format_reply,
+    parse_denial,
+)
+# Именно `common.api_client`, а не `src.common.api_client`: под двумя именами
+# это два разных модуля с разными классами, и `isinstance` в разборе ошибок не
+# сработал бы. Рантайм бота ходит через `common.*`.
+from common.api_client import APIClientError
+from src.common.entitlements_client import (
+    EntitlementsView,
+    tutor_button_label,
+)
+from src.common.user_messages import MSG_ACCESS_DENIED
+from src.common.utils.dialogs import (
+    MSG_SUBSCRIPTION_DENIED_FALLBACK,
+    map_api_error_to_user_message,
+)
+
+
+def _denial_body(detail: str = "Занятия с преподавателем — на тарифе Base") -> dict:
+    """Тело отказа LMS ровно в том виде, в каком его отдаёт обработчик DomainError."""
+    return {
+        "error": "domain_error",
+        "detail": detail,
+        "payload": {
+            "code": "subscription_denied",
+            "outcome": "denied_not_in_plan",
+            "limit": 0,
+            "remaining": 0,
+            "upgrade_hint": detail,
+        },
+    }
+
+
+# ───────────────────── Наставник: отказ вместо «сбоя» ───────────────────────
+
+
+def test_tariff_denial_is_not_reported_as_a_failure():
+    hint = parse_denial(403, _denial_body())
+    assert hint == "Занятия с преподавателем — на тарифе Base"
+    assert hint != DEGRADED_TEXT
+
+
+def test_real_failure_is_still_a_failure():
+    """403 без признака тарифа и любой 5xx остаются деградацией."""
+    assert parse_denial(403, {"detail": "Access denied"}) is None
+    assert parse_denial(500, _denial_body()) is None
+    assert parse_denial(403, None) is None
+
+
+def test_denial_without_text_still_says_what_to_do():
+    body = {"error": "domain_error", "payload": {"code": "subscription_denied"}}
+    assert parse_denial(403, body) == DENIED_FALLBACK_TEXT
+
+
+def test_denied_reply_skips_the_visibility_notice():
+    """Разговора не будет — предупреждать о его видимости не о чем."""
+    msg = format_reply(TutorReply("Наставник — на тарифе AI", denied=True), first_turn=True)
+    assert msg == "Наставник — на тарифе AI"
+    assert VISIBILITY_NOTICE not in msg
+
+
+def test_handler_does_not_add_teacher_advice_to_a_tariff_denial():
+    """Совет «напиши преподавателю» поверх отказа — второй тупик подряд.
+
+    На тарифах без наставника разбор с преподавателем закрыт тоже, и знает об
+    этом только LMS — значит текст берётся её, без приписок бота.
+    """
+    block = inspect.getsource(sab).split("async def on_results_ask_tutor")[1]
+    block = block.split("async def ")[0]
+    assert "reply.denied" in block, "обработчик не различает отказ и сбой"
+    assert "not reply.denied and (reply.offer_teacher or reply.degraded)" in block
+
+
+# ─────────────── Запрос помощи: «что даёт тариф» вместо «нет прав» ──────────
+
+
+def test_help_request_denial_explains_instead_of_refusing():
+    error = APIClientError("HTTP 403", status_code=403, body=_denial_body())
+    mapping = map_api_error_to_user_message(error, "Не удалось отправить запрос помощи.")
+    assert mapping.is_subscription_denied is True
+    assert mapping.user_message == "Занятия с преподавателем — на тарифе Base"
+    assert mapping.user_message != MSG_ACCESS_DENIED
+
+
+def test_plain_403_still_says_access_denied():
+    """Не всякий 403 — про тариф; чужая попытка так и остаётся отказом в правах."""
+    error = APIClientError("HTTP 403", status_code=403, body={"detail": "Access denied"})
+    assert map_api_error_to_user_message(error).user_message == MSG_ACCESS_DENIED
+
+
+def test_denial_without_detail_falls_back_to_a_usable_text():
+    error = APIClientError(
+        "HTTP 403", status_code=403,
+        body={"payload": {"code": "subscription_denied"}},
+    )
+    mapping = map_api_error_to_user_message(error)
+    assert mapping.user_message == MSG_SUBSCRIPTION_DENIED_FALLBACK
+    assert mapping.is_subscription_denied is True
+
+
+def test_client_keeps_the_error_body_for_the_caller():
+    """Без разобранного тела объяснение пришлось бы выуживать регулярками."""
+    src = inspect.getsource(__import__("src.common.api_client", fromlist=["x"]))
+    assert "body=body" in src, "клиент теряет тело доменного отказа"
+
+
+# ──────────────────── Остаток на кнопке до исчерпания ───────────────────────
+
+
+def _view(**tutor) -> EntitlementsView:
+    return EntitlementsView({
+        "plan_code": "ai",
+        "capabilities": {"ai_tutor": tutor},
+    })
+
+
+def test_button_shows_remaining():
+    label = tutor_button_label(_view(allowed=True, reason="allowed", limit=40, remaining=31))
+    assert "31" in label
+
+
+def test_button_warns_before_the_limit_runs_out():
+    """Порог считает LMS: свой счётчик бота однажды разошёлся бы с сайтом."""
+    label = tutor_button_label(
+        _view(allowed=True, reason="allowed", limit=40, remaining=4, warn=True)
+    )
+    assert "осталось 4" in label
+
+
+def test_button_promises_explanation_when_the_plan_has_no_tutor():
+    """Обещать разбор там, где он закрыт, значит вести ученика в отказ."""
+    label = tutor_button_label(
+        _view(allowed=False, reason="denied_not_in_plan", limit=0, remaining=0)
+    )
+    assert "разобраться" not in label.lower()
+
+
+def test_exhausted_limit_says_so_instead_of_showing_zero():
+    label = tutor_button_label(
+        _view(allowed=False, reason="denied_limit", limit=40, remaining=0, warn=True)
+    )
+    assert "кончились" in label
+
+
+def test_unlimited_plan_shows_no_number():
+    label = tutor_button_label(_view(allowed=True, reason="allowed", limit=None, remaining=None))
+    assert any(ch.isdigit() for ch in label) is False
+
+
+def test_missing_view_falls_back_to_the_plain_label():
+    """LMS не ответила — лучше кнопка без счётчика, чем выдуманное число."""
+    assert tutor_button_label(None) == "🤔 Разобраться с наставником"
+
+
+def test_button_label_comes_from_the_getter():
+    """Без ключа в поставщике `Format` подставит пустоту — кнопка станет безымянной."""
+    src = inspect.getsource(sab)
+    assert '"tutor_button_label"' in src
+    assert 'Format("{tutor_button_label}")' in src
+
+
+def test_rights_are_requested_only_when_the_button_is_shown():
+    """Запрос прав на каждом экране результатов — плата ни за что."""
+    block = inspect.getsource(sab.student_attempts_results_getter)
+    assert "if run_has_wrong:" in block
+    assert "fetch_entitlements" in block
+
+
+def test_tariff_denial_is_not_logged_as_an_error():
+    """Иначе метрика «ошибки запроса помощи» подскочит в день включения гейта.
+
+    Разбор ушёл бы искать поломку там, где сработало правило.
+    """
+    block = inspect.getsource(sab).split("async def _do_request_help")[1]
+    block = block.split("\n    async def ")[0]
+    assert "request_help_denied_by_plan" in block
+    assert "mapping.is_subscription_denied" in block
