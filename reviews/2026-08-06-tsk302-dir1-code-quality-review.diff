+    try:
+        return _run_code_quality_check_locked(code, timeout_sec=timeout_sec)
+    finally:
+        _LINT_SEMAPHORE.release()
+
+
+def _run_code_quality_check_locked(code: str, *, timeout_sec: float) -> CodeQualityResult:
