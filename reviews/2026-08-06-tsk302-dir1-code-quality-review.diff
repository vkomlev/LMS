+    command = _build_command(_LINT_RUNNER_PATH)
+    env = {
+        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+        "PYTHONPATH": str(_PROJECT_ROOT),
+    }
+
+    try:
+        with tempfile.TemporaryDirectory(prefix="turtle_sandbox_lint_") as scratch_dir:
