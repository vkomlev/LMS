+def _plural(n: int, one: str, few: str, many: str) -> str:
+    """Русское склонение: 1 попытка, 2 попытки, 5 попыток."""
+    if n % 10 == 1 and n % 100 != 11:
+        return one
+    if n % 10 in (2, 3, 4) and n % 100 not in (12, 13, 14):
+        return few
+    return many
+
