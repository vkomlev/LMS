+++ b/tests/unit/marketer-subscription-panel.test.tsx
@@ -0,0 +1,208 @@
+/**
+ * tsk-301 Фаза 9: тариф ученика в кабинете маркетолога.
+ *
+ * Проверяются требования, а не вёрстка:
+ *  - следствия смены видны ДО нажатия: тариф меняет права и группу расчёта, и
+ *    «перевёл на Self» не должно оказаться незамеченным отключением наставника;
+ *  - имя кнопки содержит НАЗВАНИЕ тарифа (уроки tsk-491/505/509): одинаковые
+ *    «Перевести» неразличимы ни глазами, ни живым прогоном;
+ *  - причина обязательна — через месяц она ниоткуда не восстановится;
+ *  - действующий тариф не предлагается сам себе: сервер ответил бы 409, а
+ *    человек увидел бы отказ на действие, которое ему предложил интерфейс;
+ *  - отказ сервера показывается словами, а не молчанием.
+ */
+import { describe, expect, it, vi, beforeEach } from "vitest";
+import { render, screen, waitFor, fireEvent } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+
+const apiGet = vi.fn();
+const apiPost = vi.fn();
+vi.mock("@/hooks/use-api-client", () => ({
+  useApiClient: () => ({ get: apiGet, post: apiPost }),
+}));
+
+import { StudentSubscriptionPanel } from "@/components/marketer/StudentSubscriptionPanel";
+
+const PLANS = [
+  {
+    code: "demo", name: "Demo", ai_tutor_limit: 0, code_review: false,
+    teacher_escalation: false, lessons: false, content: "demo",
+    pricing_group_id: null, pricing_group_name: null,
+    upgrade_hint: "Полный доступ — от 1000 ₽", sort_order: 2,
+  },
+  {
+    code: "ai", name: "AI", ai_tutor_limit: 40, code_review: true,
+    teacher_escalation: false, lessons: false, content: "full",
+    pricing_group_id: 9, pricing_group_name: "AI",
+    upgrade_hint: null, sort_order: 4,
+  },
+  {
+    code: "base", name: "Base", ai_tutor_limit: 100, code_review: true,
+    teacher_escalation: true, lessons: true, content: "full",
+    pricing_group_id: 6, pricing_group_name: "Базовый 2026",
+    upgrade_hint: null, sort_order: 5,
+  },
+];
+
+const STUDENT = { id: 4541, full_name: "Тестовский Тестер" };
+
+function state(currentCode: string | null) {
+  const current =
+    currentCode === null
+      ? null
+      : {
+          id: 10, plan_code: currentCode, plan_name: currentCode.toUpperCase(),
+          starts_on: "2026-08-01", ends_on: null, reason: "начал заниматься",
+          changed_by: 2, changed_by_name: "Виктор",
+          pricing_group_id: 6, pricing_group_name: "Базовый 2026",
+        };
+  return {
+    student_id: STUDENT.id,
+    current,
+    history: current === null ? [] : [current],
+  };
+}
+
+function mockApi(currentCode: string | null) {
+  apiGet.mockImplementation((url: string) => {
+    const path = String(url);
+    if (path.includes("/marketer/students/search")) return Promise.resolve([STUDENT]);
+    if (path.includes("/subscriptions/plans")) return Promise.resolve(PLANS);
+    if (path.includes("/subscriptions/students/")) return Promise.resolve(state(currentCode));
+    return Promise.resolve(null);
+  });
+}
+
+function renderPanel() {
+  const qc = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={qc}>
+      <StudentSubscriptionPanel />
+    </QueryClientProvider>,
+  );
+}
+
+/** Найти ученика поиском — панель начинается именно с этого. */
+async function pickStudent() {
+  const search = await waitFor(() =>
+    screen.getByTestId("marketer-subscription-student-picker"),
+  );
+  fireEvent.change(search, { target: { value: "Тест" } });
+  fireEvent.click(await waitFor(() => screen.getByText(/Тестовский Тестер/)));
+}
+
+describe("Тариф ученика в кабинете маркетолога", () => {
+  beforeEach(() => {
+    apiGet.mockReset();
+    apiPost.mockReset();
+  });
+
+  it("показывает действующий тариф и не предлагает его же", async () => {
+    mockApi("base");
+    renderPanel();
+    await pickStudent();
+
+    await waitFor(() => expect(screen.getByTestId("marketer-subscription-plan")).toBeTruthy());
+    const options = Array.from(
+      (screen.getByTestId("marketer-subscription-plan") as HTMLSelectElement).options,
+    ).map((o) => o.value);
+    expect(options).not.toContain("base");
+    expect(options).toEqual(expect.arrayContaining(["ai", "demo"]));
+  });
+
+  it("называет следствия смены до нажатия", async () => {
+    mockApi("base");
+    renderPanel();
+    await pickStudent();
+
+    fireEvent.change(await waitFor(() => screen.getByTestId("marketer-subscription-plan")), {
+      target: { value: "demo" },
+    });
+
+    const consequence = await waitFor(() =>
+      screen.getByTestId("marketer-subscription-consequence"),
+    );
+    expect(consequence.textContent).toContain("без наставника");
+    expect(consequence.textContent).toContain("не изменится");
+  });
+
+  it("на кнопке — название тарифа, а не общее «Перевести»", async () => {
+    mockApi("base");
+    renderPanel();
+    await pickStudent();
+
+    fireEvent.change(await waitFor(() => screen.getByTestId("marketer-subscription-plan")), {
+      target: { value: "ai" },
+    });
+    const button = screen.getByTestId("marketer-subscription-submit");
+    expect(button.textContent).toContain("AI");
+  });
+
+  it("без причины не отправляет", async () => {
+    mockApi("base");
+    renderPanel();
+    await pickStudent();
+
+    fireEvent.change(await waitFor(() => screen.getByTestId("marketer-subscription-plan")), {
+      target: { value: "ai" },
+    });
+    const button = screen.getByTestId("marketer-subscription-submit") as HTMLButtonElement;
+    expect(button.disabled).toBe(true);
+
+    fireEvent.change(screen.getByTestId("marketer-subscription-reason"), {
+      target: { value: "оплатил переводом" },
+    });
+    expect(
+      (screen.getByTestId("marketer-subscription-submit") as HTMLButtonElement).disabled,
+    ).toBe(false);
+  });
+
+  it("отправляет код тарифа и причину", async () => {
+    mockApi("base");
+    apiPost.mockResolvedValue(state("ai"));
+    renderPanel();
+    await pickStudent();
+
+    fireEvent.change(await waitFor(() => screen.getByTestId("marketer-subscription-plan")), {
+      target: { value: "ai" },
+    });
+    fireEvent.change(screen.getByTestId("marketer-subscription-reason"), {
+      target: { value: "оплатил переводом" },
+    });
