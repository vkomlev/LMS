+++ b/components/marketer/StudentSubscriptionPanel.tsx
@@ -0,0 +1,255 @@
+"use client";
+
+import { useState } from "react";
+
+import { PersonPicker } from "@/components/methodist/PersonPickers";
+import { Button } from "@/components/ui/button";
+import { StatusBadge } from "@/components/ui/status-badge";
+import { getApiErrorMessage } from "@/lib/api-error-messages";
+import { formatShortDate } from "@/lib/format-date";
+import { SCHOOL_TIME_ZONE } from "@/lib/time-zone";
+import {
+  useMarketerStudentSearch,
+  type StudentBrief,
+} from "@/lib/marketer/use-marketer-leads";
+import {
+  useChangeStudentPlan,
+  useStudentSubscription,
+  useSubscriptionPlans,
+  type SubscriptionHistoryItem,
+  type SubscriptionPlan,
+} from "@/lib/marketer/use-marketer-subscriptions";
+
+/**
+ * tsk-301 Фаза 9 — тариф ученика: посмотреть и сменить.
+ *
+ * Живёт на экране учеников рядом с расчётной ценой: это один и тот же вопрос с
+ * двух сторон — тариф решает, ЧТО человеку доступно, расписание решает, СКОЛЬКО
+ * он платит. Отдельного раздела для этого не заводим.
+ *
+ * Ученик ищется поиском, а не выбирается из списка: список расчётной цены
+ * показывает только тех, кто стоит денег, а тариф нужно присваивать и новичку
+ * на Demo, и выпускнику — их там нет.
+ */
+export function StudentSubscriptionPanel() {
+  const [student, setStudent] = useState<StudentBrief | null>(null);
+
+  return (
+    <section
+      data-testid="marketer-subscription-panel"
+      className="space-y-3 rounded-md border border-border bg-card p-3"
+    >
+      <header className="space-y-1">
+        <h2 className="text-base font-medium">Тариф ученика</h2>
+        <p className="text-xs text-muted-foreground">
+          Тариф задаёт права: ИИ-наставника, оценку кода, разбор с преподавателем.
+          Сумму месяца он не назначает — её по-прежнему считает расписание.
+        </p>
+      </header>
+
+      <PersonPicker<StudentBrief>
+        role={null}
+        excludeIds={[]}
+        useSearch={useMarketerStudentSearch}
+        onPick={setStudent}
+        label="Поиск ученика по имени"
+        placeholder="Имя ученика, от двух букв…"
+        testId="marketer-subscription-student-picker"
+      />
+
+      {student !== null && (
+        <StudentSubscriptionCard student={student} onClear={() => setStudent(null)} />
+      )}
+    </section>
+  );
+}
+
+function StudentSubscriptionCard({
+  student,
+  onClear,
+}: {
+  student: StudentBrief;
+  onClear: () => void;
+}) {
+  const state = useStudentSubscription(student.id);
+  const plans = useSubscriptionPlans();
+  const change = useChangeStudentPlan(student.id);
+
+  const [planCode, setPlanCode] = useState("");
+  const [reason, setReason] = useState("");
+
+  const current = state.data?.current ?? null;
+  const available = (plans.data ?? []).filter((p) => p.code !== current?.plan_code);
+  const target = available.find((p) => p.code === planCode) ?? null;
+  const canSubmit = target !== null && reason.trim().length >= 3 && !change.isPending;
+
+  return (
+    <div className="space-y-3 border-t border-border pt-3">
+      <div className="flex flex-wrap items-center gap-2">
+        <p className="min-w-0 flex-1 text-sm">
+          {student.full_name}
+          <span className="ml-2 font-mono text-xs text-muted-foreground">
+            #{student.id}
+          </span>
+        </p>
+        <Button variant="ghost" size="sm" onClick={onClear}>
+          Выбрать другого ученика
+        </Button>
+      </div>
+
+      {state.isPending && <p className="text-sm text-muted-foreground">Загружаем тариф…</p>}
+      {state.isError && (
+        <p className="text-sm text-destructive">{getApiErrorMessage(state.error).title}</p>
+      )}
+
+      {state.data !== undefined && (
+        <>
+          <CurrentPlan current={current} />
+
+          <label className="block space-y-1">
+            <span className="text-xs text-muted-foreground">Новый тариф</span>
+            <select
+              data-testid="marketer-subscription-plan"
+              aria-label="Новый тариф ученика"
+              value={planCode}
+              onChange={(e) => setPlanCode(e.target.value)}
+              className="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground"
+            >
+              <option value="">Не выбран</option>
+              {available.map((plan) => (
+                <option key={plan.code} value={plan.code} className="bg-background text-foreground">
+                  {plan.name} — {describeRights(plan)}
+                </option>
+              ))}
+            </select>
+          </label>
+
+          {target !== null && <PlanConsequence plan={target} />}
+
+          <label className="block space-y-1">
+            <span className="text-xs text-muted-foreground">
+              Зачем меняем — через месяц причина ниоткуда не восстановится
+            </span>
+            <input
+              data-testid="marketer-subscription-reason"
+              value={reason}
+              onChange={(e) => setReason(e.target.value)}
+              maxLength={500}
+              placeholder="Например: оплатил наставника переводом"
+              className="w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground"
+            />
+          </label>
+
+          <Button
+            data-testid="marketer-subscription-submit"
+            disabled={!canSubmit}
+            onClick={() =>
+              change.mutate(
+                { plan_code: target?.code ?? "", reason: reason.trim() },
+                { onSuccess: () => setReason("") },
+              )
+            }
+          >
+            {target === null ? "Выберите тариф" : `Перевести на «${target.name}»`}
+          </Button>
+
+          {change.isError && (
+            <p className="text-sm text-destructive" data-testid="marketer-subscription-error">
+              {getApiErrorMessage(change.error).title}
+            </p>
+          )}
+          {change.isSuccess && !change.isPending && (
+            <p className="text-sm text-muted-foreground">
+              Готово. Права действуют сразу, сумма текущего месяца не изменилась.
+            </p>
+          )}
+
+          <History items={state.data.history ?? []} />
+        </>
+      )}
+    </div>
+  );
+}
+
+function CurrentPlan({ current }: { current: SubscriptionHistoryItem | null }) {
+  if (current === null) {
+    return (
+      <div className="space-y-1">
+        <StatusBadge tone="waiting">Тарифа нет</StatusBadge>
+        <p className="text-xs text-muted-foreground">
+          Пока тарифа нет, ИИ-наставник и разбор с преподавателем ученику закрыты.
+        </p>
+      </div>
+    );
+  }
+  return (
+    <div className="space-y-1">
+      <div className="flex flex-wrap items-center gap-2">
+        <StatusBadge tone="success">{current.plan_name}</StatusBadge>
+        <span className="text-xs text-muted-foreground">
+          с {formatShortDate(current.starts_on, SCHOOL_TIME_ZONE)}
+        </span>
+      </div>
+      <p className="text-xs text-muted-foreground">
+        {current.pricing_group_name
+          ? `Месяц считается по группе «${current.pricing_group_name}»`
+          : "Начисления по этому тарифу не создаются"}
+        {current.reason ? ` · ${current.reason}` : ""}
+      </p>
+    </div>
+  );
+}
+
+/**
+ * Что именно изменится — до нажатия, а не после.
+ *
+ * Смена тарифа затрагивает и права, и группу расчёта: маркетолог должен видеть
+ * оба следствия рядом с кнопкой, иначе «перевёл на Self» окажется незамеченным
+ * отключением наставника.
+ */
+function PlanConsequence({ plan }: { plan: SubscriptionPlan }) {
+  return (
+    <p className="text-xs text-muted-foreground" data-testid="marketer-subscription-consequence">
+      {describeRights(plan)}.{" "}
+      {plan.pricing_group_name
+        ? `Со следующего месяца счёт по группе «${plan.pricing_group_name}»`
+        : "Начисления перестанут создаваться"}
+      . Сумма текущего месяца не изменится.
+    </p>
+  );
+}
+
+function describeRights(plan: SubscriptionPlan): string {
+  const tutor =
+    plan.ai_tutor_limit === null
+      ? "наставник без лимита"
+      : plan.ai_tutor_limit === 0
+        ? "без наставника"
+        : `наставник ${plan.ai_tutor_limit}/мес`;
+  const extras = [
+    plan.code_review ? "оценка кода" : null,
+    plan.teacher_escalation ? "разбор с преподавателем" : null,
+    plan.lessons ? "занятия" : null,
+  ].filter((x): x is string => x !== null);
+  return [tutor, ...extras].join(", ");
+}
+
+function History({ items }: { items: SubscriptionHistoryItem[] }) {
+  const past = items.filter((item) => item.ends_on !== null);
+  if (past.length === 0) return null;
+  return (
+    <details className="text-xs text-muted-foreground">
+      <summary className="cursor-pointer">История тарифов ({past.length})</summary>
+      <ul className="mt-2 space-y-1" data-testid="marketer-subscription-history">
+        {past.map((item) => (
+          <li key={item.id}>
+            {item.plan_name}: {formatShortDate(item.starts_on, SCHOOL_TIME_ZONE)} —{" "}
+            {item.ends_on ? formatShortDate(item.ends_on, SCHOOL_TIME_ZONE) : "…"}
+            {item.changed_by_name ? ` · ${item.changed_by_name}` : ""}
+            {item.reason ? ` · ${item.reason}` : ""}
+          </li>
+        ))}
+      </ul>
+    </details>
+  );
+}
