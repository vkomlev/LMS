@@ -0,0 +1,65 @@
+"use client";
+
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+
+import { useApiClient } from "@/hooks/use-api-client";
+import type { components } from "@/lib/api-types";
+
+/**
+ * tsk-301 Фаза 9 — тарифы учеников в кабинете маркетолога.
+ *
+ * Тариф даёт ПРАВА, расписание порождает ДЕНЬГИ: здесь нет ни одной суммы.
+ * Присвоение только указывает, по какой группе считать месяц; сколько именно
+ * насчитать, решают занятия. Поэтому соседний экран расчётной цены эти хуки не
+ * трогают и его кэш не сбрасывают — кроме одного случая, описанного ниже.
+ */
+
+export type SubscriptionPlan = components["schemas"]["SubscriptionPlanRead"];
+export type SubscriptionHistoryItem = components["schemas"]["SubscriptionHistoryItem"];
+export type StudentSubscriptionState = components["schemas"]["StudentSubscriptionState"];
+export type SubscriptionChange = components["schemas"]["SubscriptionChangeRequest"];
+
+const PLANS_KEY = ["marketer", "subscription-plans"] as const;
+
+export function useSubscriptionPlans() {
+  const client = useApiClient();
+  return useQuery<SubscriptionPlan[]>({
+    queryKey: PLANS_KEY,
+    queryFn: () => client.get<SubscriptionPlan[]>("/api/v1/subscriptions/plans"),
+    staleTime: 10 * 60 * 1_000,
+    retry: false,
+  });
+}
+
+export function useStudentSubscription(studentId: number | null) {
+  const client = useApiClient();
+  return useQuery<StudentSubscriptionState>({
+    queryKey: ["marketer", "subscription", studentId],
+    queryFn: () =>
+      client.get<StudentSubscriptionState>(
+        `/api/v1/subscriptions/students/${studentId}`,
+      ),
+    enabled: studentId !== null,
+    retry: false,
+  });
+}
+
+export function useChangeStudentPlan(studentId: number | null) {
+  const client = useApiClient();
+  const qc = useQueryClient();
+  return useMutation<StudentSubscriptionState, Error, SubscriptionChange>({
+    mutationFn: (body) =>
+      client.post<StudentSubscriptionState>(
+        `/api/v1/subscriptions/students/${studentId}`,
+        body,
+      ),
+    onSuccess: (state) => {
+      qc.setQueryData(["marketer", "subscription", studentId], state);
+      // Расчётная цена зависит от тарифной группы, а группа могла смениться.
+      // Сумму текущего месяца это не переписывает (решение 14), но список
+      // учеников на соседнем экране собирается по действующей подписке — он
+      // показал бы прежнюю группу до перезагрузки страницы.
+      void qc.invalidateQueries({ queryKey: ["marketer", "pricing", "students"] });
+    },
+  });
+}
