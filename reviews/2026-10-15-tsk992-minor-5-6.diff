+    assert review["task_result_id"] not in [i["task_result_id"] for i in failed]
+    everything = await _hist("all")
+    marked = {i["task_result_id"]: i["is_retrieval"] for i in everything}
+    assert marked[review["task_result_id"]] is True
+
