# LMS Core API — пример .env (Y-1..Y-4 pre-S5).
# Скопируйте в .env и заполните реальными значениями. НЕ коммитьте .env.

# ────────────────────── Core ──────────────────────

# URL подключения к БД (SQLAlchemy AsyncPG)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/Learn

# tsk-621: размер пула подключений на один рабочий процесс. По умолчанию
# 10 постоянных + 20 сверх лимита = 30. Лимит подключений на сервере БД общий
# для всех баз (на проде 200, там же живут три полигонных сервиса), поэтому
# поднимать стоит осознанно: суммарно все процессы должны укладываться в лимит
# с запасом. Пустое значение или мусор — берутся значения по умолчанию.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# tsk-621: порог в секундах, после которого запрос попадает в лог как
# медленный (строка «slow request»). По умолчанию 3.
# SLOW_REQUEST_SECONDS=3

# tsk-644: тот же порог заводит строку в таблице `slow_request` — её читает
# недельный чек `weekly_checks.py slow-requests`. Запись идёт мимо ответа
# пользователю; эти два числа ограничивают её аппетит при шторме.
# SLOW_REQUEST_WRITE_LIMIT=8
# SLOW_REQUEST_WRITE_TIMEOUT=5

# tsk-644: сколько ждём файловое хранилище. До этой задачи клиент работал на
# умолчаниях botocore (60 с соединение, 60 с чтение, повторы legacy), и молчащее
# хранилище держало приём ответа ученика до пяти минут.
# S3_RETRIES — повторы СВЕРХ первой попытки (так их читает botocore).
# S3_CONNECT_TIMEOUT_SEC=3
# S3_READ_TIMEOUT_SEC=20
# S3_RETRIES=1

# tsk-644: потолки ожидания на пути ученика (секунды).
# CODE_PICK_TIMEOUT_SEC — снимок кода для преподавателя; не успели, работа
#   уходит в очередь без снимка (ученик этот отчёт не видит никогда).
# ATTACHMENT_GATE_TIMEOUT_SEC — проверка вложения, от неё зависит зачёт; не
#   успели — честный 503 с Retry-After, а не молчаливый пропуск защиты.
# CODE_PICK_TIMEOUT_SEC=3
# ATTACHMENT_GATE_TIMEOUT_SEC=5

# tsk-644: через сколько минут работа, взятая тиком оценки кода, снова считается
# свободной (страховка на случай, если процесс умер посреди прохода).
# CODE_REVIEW_CLAIM_TTL_MIN=15

# Список service API-ключей через запятую (без пробелов).
# Используют: TG_LMS bots (poller, teacher dialog), ContentBackbone CLI,
# SPW E2E live spec (Y-4 S5 через /auth/test/issue-session).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Документация: docs/operations/service-api-key.md
VALID_API_KEYS=replace-with-token-urlsafe-48,optional-second-key

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Environment marker: dev | test | production
# Используется fail-secure security-critical сервисами (Y-3.1 link_token,
# Y-4 pre-S5 test_endpoints_enabled gating).
ENV=dev

# ────────────────────── Y-4 pre-S5: тестовые auth-эндпоинты ──────────────────────

# POST /auth/test/issue-session — bootstrap cookie для E2E spec'ов.
# KEEP FALSE in prod даже если ENV случайно = dev/test.
# Двойной gating: ENV in {"dev","test"} AND TEST_ENDPOINTS_ENABLED=true → endpoint работает.
TEST_ENDPOINTS_ENABLED=false

# Cookie secure flag — True в prod (HTTPS), False в dev (HTTP localhost)
COOKIE_SECURE=false

# Domain сессионной cookie — пусто в dev (host-only). В prod ОБЯЗАТЕЛЬНО
# learn.victor-komlev.ru (ADR-0014), НЕ victor-komlev.ru — иначе cookie
# делит scope с WordPress на www.victor-komlev.ru (tsk-161).
COOKIE_DOMAIN=

# ────────────────────── Phase Y-1 auth ──────────────────────

# Resend для magic-link email; пустой → dev-fallback (лог в stdout)
RESEND_API_KEY=
SMTP_FROM=noreply@victor-komlev.ru

# Базовый URL SPW для встраивания в magic-link письма + email-шаблоны Y-4.
# Dev: http://localhost:3000; prod: https://learn.victor-komlev.ru
PUBLIC_BASE_URL=http://localhost:3000

# Telegram-ник для заявок с квиза-лид-магнита (tsk-053), без «@».
# Ссылка на экране итога собирается как https://t.me/<ник>?text=...
QUIZ_CONTACT_TG=Vvkomlev

# Секреты для подписи magic-link / session — генерация:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MAGIC_LINK_SECRET=replace-with-token-urlsafe-48
SESSION_SIGNING_KEY=replace-with-token-urlsafe-48
FERNET_MASTER_KEY=replace-with-fernet-key

# Подпись одноразового токена для embed-iframe (`/embed-api/*`, Y-5).
# ПУСТО = контур выключен целиком: обе ручки отвечают 503 ещё до выборки
# (fail-secure). Так он и стоял на проде до 2026-08-27 (tsk-708).
# Генерация: openssl rand -hex 48
CB_EMBED_JWT_SECRET=
# TTL токена в секундах (по умолчанию 300 — пяти минут хватает, токен одноразовый)
CB_EMBED_JWT_TTL_SEC=300

# TG initData verification (HMAC от bot_token)
TG_BOT_TOKEN_FOR_INITDATA=

# VK ID 2.0 PKCE
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=

# Redis для rate-limit + session cache + link_token
REDIS_URL=redis://localhost:6379/2

# ────────────────────── CORS ──────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ────────────────────── Imports / прочее ──────────────────────

GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=Tasks
GSHEETS_SERVICE_ACCOUNT_JSON=

DEFAULT_POINTS_SHORT_ANSWER=10
PREPEND_INPUT_LINK=true
INPUT_LINK_LABEL=Входные данные

LEARNING_ENGINE_V1=false

MESSAGES_UPLOAD_DIR=uploads/messages
MATERIALS_UPLOAD_DIR=uploads/materials
MAX_ATTACHMENT_SIZE_BYTES=10485760
ATTACHMENT_CHUNK_SIZE=1048576

# CAS media (ADR-0040, tsk-110) — dev-fallback, если S3_MEDIA_BUCKET_URL не задан
CAS_MEDIA_ROOT=data/media_store
# S3-редирект (ADR-0047, tsk-160) — публичный базовый URL bucket'а, без секретов
# (LMS не хранит S3 credentials, только строит редирект). Пример:
# S3_MEDIA_BUCKET_URL=https://s3.twcstorage.ru/lms-media-cas
S3_MEDIA_BUCKET_URL=
# Developement
ENV=dev
TEST_ENDPOINTS_ENABLED=true
COOKIE_SECURE=false
# ---------- LLM (tsk-572 / tsk-302) ----------
# Подключение: канон ADR-0046, приоритет <PROVIDER>_* над legacy CB_CLAUDE_*.
# Ключ переносится из ContentBackbone скриптом scripts/import_llm_key_from_cb.py
# ВНИМАНИЕ: в .env только латиница (кириллица уже ломала чтение настроек).
CLOSEROUTER_API_KEY=
# base_url нормализуется клиентом: хвостовой /v1 срезается перед склейкой,
# поэтому оба написания (с /v1 и без) допустимы.
CLOSEROUTER_BASE_URL=https://api.closerouter.dev

# Политика моделей (локальная). Цепочка отката слева направо.
# Переход к следующей: upstream_error / 404-модель / исчерпана квота.
# При 429 перехода НЕТ - остывание провайдера на LLM_COOLDOWN_SECONDS.
# Обоснование выбора и стенд: docs/specs/2026-08-06-contract-llm-client.md §6a
# Nastavnickaya cepochka: kanon s tsk-748 zhivet v app/services/llm/providers.py
# (_DEFAULT_TUTOR_MODELS, 7 modeley, golova sonnet-4.6 - reshenie operatora 31.08).
# Peremenna nizhe - tolko pereopredelenie; pustaya = beryotsya kanon iz koda.
# Stend 2026-09-01: sonnet-4.6 0/3 slivov, 3.5 c. sonnet-5 i haiku-4.5 sryvayutsya
# 3/3 na rezhime thin, no strazh vyvoda (ai_tutor/answer_guard.py) rezhet vsyo.
LLM_TUTOR_MODELS=
# Sudeyskaya cepochka peresobrana 2026-09-01 po stendu (tsk-573):
# gemini-3.7-flash otbita 6/6 po dengam upstream, gpt-5.4 - 93 c pri byudzhete 30 c.
LLM_JUDGE_MODELS=openai/gpt-5.6-luna,z-ai/glm-5.3,openai/gpt-5.6-sol,google/gemini-3.6-flash,openai/gpt-5.4
# Ротация (tsk-671): сколько секунд модель считается «только что отказавшей»
# и уходит в конец очереди, чтобы следующий ученик не платил за тот же отказ.
LLM_MODEL_COOLDOWN_SECONDS=120
LLM_COOLDOWN_SECONDS=120
# Еженедельная проверка цепочек (tsk-678). Судейские модели проверяются
# настоящим разбором (формат + бюджет), наставницкие - дешёвым «жива ли».
# Отказавшая уходит в конец очереди до следующего прохода; СОСТАВ цепочки
# проход не меняет - его утверждает стенд с оператором.
LLM_CHAIN_CHECK_ENABLED=true
LLM_CHAIN_CHECK_INTERVAL_HOURS=168
LLM_CHAIN_CHECK_STARTUP_DELAY_MIN=5

# ---------- tsk-591: простой ученика во время занятия ----------
# Сигнал преподавателю о том, что ученик завис или ушёл, пока идёт занятие.
# Порог 10 минут - решение оператора 2026-08-09. Тик чаще порога, чтобы простой
# обнаруживался на 10-13-й минуте, а не на 20-й.
# LESSON_IDLE_CRON_ENABLED=true
# LESSON_IDLE_CRON_INTERVAL_MIN=3
# LESSON_IDLE_THRESHOLD_MINUTES=10
# Как часто кабинет шлёт пульс присутствия и сколько пульс считается свежим.
# Второе заведомо больше первого: один потерянный сигнал (обрыв сети, спящая
# вкладка) не должен превращать ученика в "ушёл".
# PRESENCE_PING_SECONDS=120
# PRESENCE_STALE_SECONDS=420

# ---------- tsk-721: правила школы правит администратор в кабинете ----------
# 24 значения ниже и выше по этому файлу теперь можно менять в кабинете
# администратора (раздел "Настройки школы"), не заходя на сервер: пороги
# занятий, окна сигналов о рисках, день закрытия занятий за неоплату, цена
# пакета обращений к наставнику, рубильники фоновых проходов.
#
# Порядок источников: КАБИНЕТ -> эта переменная -> умолчание в коде.
# Значение отсюда действует, только пока в кабинете по этой настройке ничего
# не сохранено. Сохранил администратор - правка файла его молча не отменит;
# чтобы вернуть управление файлу, нужно нажать в кабинете "вернуть как было".
#
# Правка в кабинете действует БЕЗ перезапуска: значение читается в момент
# применения. Правка ЭТОГО файла по-прежнему требует перезапуска.
#
# Секретов в кабинете нет и быть не может - ключи, токены и пароли остаются
# только здесь. Список того, что вынесено: app/core/settings_registry.py.
