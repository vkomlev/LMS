# LMS, экземпляр «pilot» — копия платформы для школы коллег (tsk-764).
# Скопировать на сервере в /opt/lms-pilot/.env и заполнить помеченные REPLACE_ME.
#
# Отличий от боевого .env три, и все три — про изоляцию:
#   1. своя база (`pilot`, роль `pilot_app`) на том же кластере 5.42.107.253;
#   2. свой номер базы Redis (боевой держит 2, полигон 3/4/5 — здесь 6);
#   3. свой домен в COOKIE_DOMAIN — иначе cookie сессии стала бы общей с боевым.
#
# Секреты (MAGIC_LINK_SECRET, SESSION_SIGNING_KEY, VALID_API_KEYS) — СВОИ,
# не боевые: экземпляр чужой школы не должен принимать боевой ключ и наоборот.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+asyncpg://pilot_app:REPLACE_ME@5.42.107.253:5432/pilot
REDIS_URL=redis://default:REPLACE_ME_SAME_PASSWORD_AS_PROD@94.141.162.219:6379/6

ENV=production
LOG_LEVEL=INFO
TEST_ENDPOINTS_ENABLED=false

COOKIE_SECURE=true
COOKIE_DOMAIN=pilot.victor-komlev.ru
PUBLIC_BASE_URL=https://pilot.victor-komlev.ru
CORS_ALLOWED_ORIGINS=https://pilot.victor-komlev.ru

VALID_API_KEYS=REPLACE_ME_token_urlsafe_48
MAGIC_LINK_SECRET=REPLACE_ME_token_urlsafe_48
SESSION_SIGNING_KEY=REPLACE_ME_token_urlsafe_48
FERNET_MASTER_KEY=REPLACE_ME_fernet_key

# Письма со ссылкой для входа. Ключ и отправитель на время пилота общие с боевым:
# домен для писем один, заводить второй ради пилота смысла нет. Их преподаватель
# и ученики получат письмо с адреса noreply@victor-komlev.ru — это видно человеку,
# и это осознанное решение пилота, а не недосмотр.
RESEND_API_KEY=REPLACE_ME_SAME_AS_PROD
SMTP_FROM=noreply@victor-komlev.ru

# Хранилище файлов — СВОЁ, локальное. Боевой кладёт медиа в общий бакет S3;
# пилот туда не пишет, иначе файлы двух школ легли бы в одну кучу.
CAS_MEDIA_ROOT=data/media_store
S3_MEDIA_BUCKET_URL=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

MESSAGES_UPLOAD_DIR=uploads/messages
MATERIALS_UPLOAD_DIR=uploads/materials
MAX_ATTACHMENT_SIZE_BYTES=10485760
ATTACHMENT_CHUNK_SIZE=1048576

# Деньги на пилоте выключены: у чужой школы свои расчёты, наша касса тут ни при чём.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ALLOW_LIVE=false
SUBSCRIPTION_GATE_MODE=off
FIRST_MONTH_CHARGE_CUTOFF_DAY=20

# Вход через Telegram и VK на пилоте не заводим — только ссылка на почту.
TG_BOT_TOKEN_FOR_INITDATA=
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=

# Импорт заданий из Google Sheets — наш рабочий инструмент, чужому экземпляру не нужен.
GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=Tasks
GSHEETS_SERVICE_ACCOUNT_JSON=

# ИИ-наставник выключен: он платный и считается по нашему счёту у провайдера.
# Рубильник ставится ЯВНО: по умолчанию в коде он включён (`app/core/config.py`),
# и без этой строки экземпляр звал бы провайдера без ключа. Тем же порядком —
# ночной разбор пробелов: на пустой базе ему нечего считать.
AI_TUTOR_ENABLED=false
LEARNING_GAPS_CRON_ENABLED=false
CLOSEROUTER_API_KEY=
CLOSEROUTER_BASE_URL=
LLM_CHAIN_CHECK_ENABLED=false

DEFAULT_POINTS_SHORT_ANSWER=10
PREPEND_INPUT_LINK=true
INPUT_LINK_LABEL=Входные данные
LEARNING_ENGINE_V1=false
