# LMS-полигон, tier=test (tsk-182). Скопировать на сервере в .env.test, заполнить.
# Отличие от dev: honest HTTPS/cookie-режим (COOKIE_SECURE=true) — тестовые
# эндпоинты всё ещё включены (poligon-login работает так же, как на dev).
#
# Пересмотр 2026-07-25: DATABASE_URL на существующем прод-Postgres-инстансе
# (5.42.107.253) — БД poligon_test, роль poligon_test_app.
#
# ИСПРАВЛЕНО 2026-07-26: REDIS_URL — НЕ localhost (на lms-spw-vds Redis не
# запущен), тот же удалённый managed-инстанс, что в прод .env
# (94.141.162.219:6379, тот же пароль), db=4.

DATABASE_URL=postgresql+asyncpg://poligon_test_app:REPLACE_ME@5.42.107.253:5432/poligon_test
REDIS_URL=redis://default:REPLACE_ME_SAME_PASSWORD_AS_PROD_REDIS_URL@94.141.162.219:6379/4

VALID_API_KEYS=replace-with-token-urlsafe-48

LOG_LEVEL=INFO

ENV=test
TEST_ENDPOINTS_ENABLED=true
COOKIE_SECURE=true
COOKIE_DOMAIN=

RESEND_API_KEY=
SMTP_FROM=noreply@victor-komlev.ru
PUBLIC_BASE_URL=https://test-poligon.victor-komlev.ru

MAGIC_LINK_SECRET=replace-with-token-urlsafe-48
SESSION_SIGNING_KEY=replace-with-token-urlsafe-48
FERNET_MASTER_KEY=replace-with-fernet-key

TG_BOT_TOKEN_FOR_INITDATA=
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=

CORS_ALLOWED_ORIGINS=https://test-poligon.victor-komlev.ru

GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=Tasks
GSHEETS_SERVICE_ACCOUNT_JSON=

DEFAULT_POINTS_SHORT_ANSWER=10
PREPEND_INPUT_LINK=true
INPUT_LINK_LABEL=Входные данные

LEARNING_ENGINE_V1=false

MESSAGES_UPLOAD_DIR=uploads/messages
MATERIALS_UPLOAD_DIR=uploads/materials
MAX_ATTACHMENT_SIZE_BYTES=10485760
ATTACHMENT_CHUNK_SIZE=1048576

CAS_MEDIA_ROOT=data/media_store
S3_MEDIA_BUCKET_URL=
