# LMS-полигон, tier=stage (tsk-182). Скопировать на сервере в .env.stage, заполнить.
#
# КЛЮЧЕВОЕ ОТЛИЧИЕ от dev/test: ENV=production + TEST_ENDPOINTS_ENABLED=false —
# зеркалит реальный прод-режим. /auth/test/issue-session реально отдаёт 404
# (двойной gate в app/api/v1/auth/test_session.py живой, не бутафория) — на
# этом tier'е poligon-login-страница НЕ сработает по умолчанию (см. брифе,
# «Открытые решения» — honest email-вход как TODO). До реализации honest-входа
# держите на этом tier'е TEST_ENDPOINTS_ENABLED=true как временное исключение,
# явно задокументировав отклонение от «настоящего прода» в реестре полигона.

# Пересмотр 2026-07-25: DATABASE_URL на существующем прод-Postgres-инстансе
# (5.42.107.253) — БД poligon_stage, роль poligon_stage_app. REDIS_URL —
# localhost (общий Redis-процесс lms-spw-vds), db=5.
DATABASE_URL=postgresql+asyncpg://poligon_stage_app:REPLACE_ME@5.42.107.253:5432/poligon_stage
REDIS_URL=redis://localhost:6379/5

VALID_API_KEYS=replace-with-token-urlsafe-48

LOG_LEVEL=INFO

ENV=production
TEST_ENDPOINTS_ENABLED=false
COOKIE_SECURE=true
COOKIE_DOMAIN=

RESEND_API_KEY=
SMTP_FROM=noreply@victor-komlev.ru
PUBLIC_BASE_URL=https://stage-poligon.victor-komlev.ru

MAGIC_LINK_SECRET=replace-with-token-urlsafe-48
SESSION_SIGNING_KEY=replace-with-token-urlsafe-48
FERNET_MASTER_KEY=replace-with-fernet-key

TG_BOT_TOKEN_FOR_INITDATA=
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=

CORS_ALLOWED_ORIGINS=https://stage-poligon.victor-komlev.ru

GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=Tasks
GSHEETS_SERVICE_ACCOUNT_JSON=

DEFAULT_POINTS_SHORT_ANSWER=10
PREPEND_INPUT_LINK=true
INPUT_LINK_LABEL=Входные данные

LEARNING_ENGINE_V1=false

MESSAGES_UPLOAD_DIR=uploads/messages
MATERIALS_UPLOAD_DIR=uploads/materials
MAX_ATTACHMENT_SIZE_BYTES=10485760
ATTACHMENT_CHUNK_SIZE=1048576

CAS_MEDIA_ROOT=data/media_store
S3_MEDIA_BUCKET_URL=
