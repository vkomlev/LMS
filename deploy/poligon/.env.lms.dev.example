# LMS-полигон, tier=dev (tsk-182). Скопировать на сервере в .env.dev, заполнить.
# Ключевое отличие dev/test/stage — не код, а именно этот файл (см. бриф).
#
# Пересмотр 2026-07-25: DATABASE_URL указывает на СУЩЕСТВУЮЩИЙ прод-Postgres-
# инстанс (5.42.107.253, там же learn/content_backbone) — НЕ localhost, БД
# новая (poligon_dev), роль новая (poligon_dev_app), права только на неё.
# REDIS_URL — localhost (Redis уже работает на lms-spw-vds для прод LMS,
# db=2) — полигон-dev занимает db=3, не устанавливаем новый Redis-процесс.

DATABASE_URL=postgresql+asyncpg://poligon_dev_app:REPLACE_ME@5.42.107.253:5432/poligon_dev
REDIS_URL=redis://localhost:6379/3

# Список API-ключей полигона — СВОИ, не пересекаются с прод VALID_API_KEYS.
# Используется /auth/test/issue-session (poligon-login страница SPW).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
VALID_API_KEYS=replace-with-token-urlsafe-48

LOG_LEVEL=INFO

# dev-tier: honest-поведение локальной разработки — тестовые эндпоинты включены.
ENV=dev
TEST_ENDPOINTS_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=

RESEND_API_KEY=
SMTP_FROM=noreply@victor-komlev.ru
PUBLIC_BASE_URL=https://dev-poligon.victor-komlev.ru

# Полигон НЕ использует прод MAGIC_LINK_SECRET/SESSION_SIGNING_KEY/FERNET_MASTER_KEY —
# сгенерировать НОВЫЕ значения, свои для полигона (изоляция секретов от прода):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MAGIC_LINK_SECRET=replace-with-token-urlsafe-48
SESSION_SIGNING_KEY=replace-with-token-urlsafe-48
FERNET_MASTER_KEY=replace-with-fernet-key

TG_BOT_TOKEN_FOR_INITDATA=
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=

CORS_ALLOWED_ORIGINS=https://dev-poligon.victor-komlev.ru

GSHEETS_SPREADSHEET_ID=
GSHEETS_WORKSHEET_NAME=Tasks
GSHEETS_SERVICE_ACCOUNT_JSON=

DEFAULT_POINTS_SHORT_ANSWER=10
PREPEND_INPUT_LINK=true
INPUT_LINK_LABEL=Входные данные

LEARNING_ENGINE_V1=false

MESSAGES_UPLOAD_DIR=uploads/messages
MATERIALS_UPLOAD_DIR=uploads/materials
MAX_ATTACHMENT_SIZE_BYTES=10485760
ATTACHMENT_CHUNK_SIZE=1048576

CAS_MEDIA_ROOT=data/media_store
S3_MEDIA_BUCKET_URL=

# tsk-182: safety guard в scripts/poligon_seed.py читает этот хост из
# DATABASE_URL — держать его отличным от прод-хостов (учебный VDS, не
# lms-spw-vds/DBaaS ContentBackbone).
