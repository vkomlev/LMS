[Unit]
Description=LMS: запуск караула заторов по будням (tsk-655/tsk-735)

[Timer]
# Будни, 07:30 UTC = 10:30 МСК. Раньше первого занятия учебного дня: 31.08
# ближайшие занятия начинаются в 07:00 и 08:00 UTC, а караулит программа не
# начало, а ГРАНИЦУ — с 10 минут до конца и 20 минут после (заторы случаются,
# когда группа разом идёт к следующему заданию).
#
# Занятий утром может не быть вовсе — тогда программа скажет «караулить нечего»
# и выйдет, ничего не сняв.
OnCalendar=Mon..Fri *-*-* 07:30:00 UTC

# Пропущенный запуск НЕ доигрывается: караул привязан к живому окну занятия,
# и запуск задним числом снял бы тишину и выглядел бы как «затора не было» —
# худший исход замера, он закрывает вопрос неверно.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
